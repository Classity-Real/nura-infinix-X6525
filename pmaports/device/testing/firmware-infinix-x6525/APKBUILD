# Reference: <https://postmarketos.org/devicepkg>
maintainer="Seuj09 <jeus110310@gmail.com>"
pkgname=firmware-infinix-x6525
pkgver=1
pkgrel=0
pkgdesc="Firmware for the Infinix X6525"
url=""
arch="aarch64"
license="proprietary"
options="!check !archcheck !strip !spdx !tracedeps pmb:cross-native"

# The touch controller has no flash: after every reset the driver downloads an
# HDL image, which it finds through firmware-name in the board device tree -
# postmarketos/sprd/hdl_firmware_01.img.
#
# The file comes off the device itself (/vendor/firmware/hdl_firmware_01.img on
# the stock system - the image its running module asks for, and the one with the
# DISPLAY area for this panel). The tarball, its checksum and where it will live
# are all settled; the release has not been published yet, because that is a
# public act on a public repository. One command does it - see ../README.md -
# after which source= becomes:
#   source="$_tarball::https://github.com/Seuj09/ums9230-mainline-linux/releases/download/firmware-v1/$_tarball"
# and the copy of the tarball that is already in ../../../firmware/ is what gets
# uploaded, so the checksum below does not change.
# Note a release asset on *this* repository would not do: it is private, and
# pmaports CI has to be able to fetch it.
_tarball="firmware-infinix-x6525-$pkgver.tar.gz"
source="$_tarball::TODO-publish-and-put-the-url-here"

package() {
	install -Dm644 "$srcdir"/hdl_firmware_01.img \
		"$pkgdir"/lib/firmware/postmarketos/sprd/hdl_firmware_01.img
}

sha512sums="
a8ae389d7479ad8b3226cfb3a0d153f5306cdbe6a9b85e31584c5e6c7c34232a06562134ac9b3669fb4a0919e3335a830bd2b7b08a87e132c500d22fe70fa176  $_tarball
"
