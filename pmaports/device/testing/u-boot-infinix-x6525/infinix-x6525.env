preboot=
 if load mmc 0#prodnv 0x9c000000 /btmac.txt 0x11; then
  mw.b 0x9c000011 0;
  setexpr.s bdaddr *0x9c000000;
 fi;
 if load mmc 0#prodnv 0x9c000000 /wifimac.txt 0x11; then
  mw.b 0x9c000011 0;
  setexpr.s wifiaddr *0x9c000000;
 fi
bootcmd=pmicwdt stop; sleep 5; pstore display console; pstore display dump; sleep 15; bootflow scan -lb mmc; bootflow scan -lb scsi; echo === no bootflow: the cache partition ===; part number mmc 0 cache cachenum; echo cache is partition ${cachenum}; ls mmc 0:${cachenum} /; ls mmc 0:${cachenum} /extlinux; echo === no bootflow on scsi: the cache partition ===; part number scsi 0 cache cachenum; echo cache is partition ${cachenum}; ls scsi 0:${cachenum} /; ls scsi 0:${cachenum} /extlinux
fdt_addr_r=0x9df00000
kernel_addr_r=0x80080000
kernel_comp_addr_r=0xc0000000
kernel_comp_size=0x10000000
ramdisk_addr_r=0xa0000000
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
