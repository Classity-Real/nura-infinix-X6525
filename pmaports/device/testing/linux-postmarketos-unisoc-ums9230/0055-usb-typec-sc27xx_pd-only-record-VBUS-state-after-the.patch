From cc738cdf4d0147d62fb101987f1e73624f23a823 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sun, 1 Nov 2026 07:02:54 +0800
Subject: [PATCH] usb: typec: sc27xx_pd: only record VBUS state after the
 regulator changed

sc27xx_pd_set_vbus() set vbus_on before calling regulator_enable()/disable()
and kept it when the call failed, so a failed enable made the next detach
disable a regulator that was never enabled (WARN: unbalanced disables for
bq2415x-otg) and hid the error. Record the state only on success and log the
failure.
---
 drivers/usb/typec/tcpm/sc27xx_pd.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/typec/tcpm/sc27xx_pd.c b/drivers/usb/typec/tcpm/sc27xx_pd.c
index cba02da28..15a116ace 100644
--- a/drivers/usb/typec/tcpm/sc27xx_pd.c
+++ b/drivers/usb/typec/tcpm/sc27xx_pd.c
@@ -456,15 +456,23 @@ static int sc27xx_pd_set_vbus(struct tcpc_dev *tcpc, bool on, bool charge)
 	if (!pd->vbus || pd->vbus_on == on)
 		goto out;
 
-	pd->vbus_on = on;
-
 	if (on)
 		ret = regulator_enable(pd->vbus);
 	else
 		ret = regulator_disable(pd->vbus);
 
-	if (ret < 0)
+	if (ret < 0) {
+		/*
+		 * Only record the new state once the regulator really changed:
+		 * otherwise a failed enable leaves vbus_on set and the next
+		 * detach disables a regulator that was never enabled.
+		 */
+		dev_err(pd->dev, "failed to %s vbus: %d\n",
+			on ? "enable" : "disable", ret);
 		goto out;
+	}
+
+	pd->vbus_on = on;
 
 	/* no VBUS interrupts are sent, so polling is needed */
 	if (!pd->detect_pending) {
-- 
