From 8a9d1c2e3f4b5a6d7e8f9a0b1c2d3e4f5a6b7c8d Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sun, 18 Oct 2026 07:20:00 +0000
Subject: [PATCH] spi: sprd: fix full-duplex PIO/DMA RX length and interrupt
 status clear

When a full-duplex transfer sets both tx_buf and rx_buf (such as OmniVision
TCM SPI touchscreen reads that clock 0xff on MOSI while reading MISO),
ss->trans_mode has both SPRD_SPI_TX_MODE and SPRD_SPI_RX_MODE set.

In sprd_spi_txrx_bufs() and sprd_spi_dma_txrx_bufs(), the SPRD_SPI_TX_MODE
branch only programmed SPRD_SPI_CTL8/CTL9 (TX length) and skipped
sprd_spi_set_rx_length() in the else branch, leaving SPRD_SPI_CTL10/CTL11
(RX length) at zero so the RX FIFO never captured the incoming bytes.

Additionally, match the vendor 5.4 driver by clearing both TX_END and RX_END
interrupt bits after each transfer and clearing SPRD_SPI_ALL_INT_CLR (0x33f)
in sprd_spi_init_hw().

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 drivers/spi/spi-sprd.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/drivers/spi/spi-sprd.c b/drivers/spi/spi-sprd.c
index eda9471..782d8a1 100644
--- a/drivers/spi/spi-sprd.c
+++ b/drivers/spi/spi-sprd.c
@@ -89,6 +89,7 @@
 /* Bits & mask definition for register SPI_INT_CLR */
 #define SPRD_SPI_RX_END_INT_CLR		BIT(9)
 #define SPRD_SPI_TX_END_INT_CLR		BIT(8)
+#define SPRD_SPI_ALL_INT_CLR		0x33f
 
 /* Bits & mask definition for register SPI_INT_RAW */
 #define SPRD_SPI_RX_END_IRQ		BIT(9)
@@ -210,7 +211,8 @@ static int sprd_spi_wait_for_tx_end(struct sprd_spi *ss, struct spi_transfer *t)
 		return ret;
 	}
 
-	writel_relaxed(SPRD_SPI_TX_END_INT_CLR, ss->base + SPRD_SPI_INT_CLR);
+	writel_relaxed(SPRD_SPI_TX_END_INT_CLR | SPRD_SPI_RX_END_INT_CLR,
+		       ss->base + SPRD_SPI_INT_CLR);
 
 	return 0;
 }
@@ -228,7 +230,8 @@ static int sprd_spi_wait_for_rx_end(struct sprd_spi *ss, struct spi_transfer *t)
 		return ret;
 	}
 
-	writel_relaxed(SPRD_SPI_RX_END_INT_CLR, ss->base + SPRD_SPI_INT_CLR);
+	writel_relaxed(SPRD_SPI_TX_END_INT_CLR | SPRD_SPI_RX_END_INT_CLR,
+		       ss->base + SPRD_SPI_INT_CLR);
 
 	return 0;
 }
@@ -409,6 +412,8 @@ static int sprd_spi_txrx_bufs(struct spi_device *sdev, struct spi_transfer *t)
 			trans_len;
 		if (ss->trans_mode & SPRD_SPI_TX_MODE) {
 			sprd_spi_set_tx_length(ss, len);
+			if (ss->trans_mode & SPRD_SPI_RX_MODE)
+				sprd_spi_set_rx_length(ss, len);
 			write_size += ss->write_bufs(ss, len);
 
 			/*
@@ -614,6 +619,7 @@ static int sprd_spi_dma_txrx_bufs(struct spi_device *sdev,
 	}
 
 	if (ss->trans_mode & SPRD_SPI_RX_MODE) {
+		sprd_spi_set_rx_length(ss, trans_len);
 		/*
 		 * Set up the DMA receive data length, which must be an
 		 * integral multiple of fragment length. But when the length
@@ -708,6 +714,9 @@ static int sprd_spi_init_hw(struct sprd_spi *ss, struct spi_transfer *t)
 
 	writel_relaxed(val, ss->base + SPRD_SPI_CTL7);
 
+	/* Clear all interrupt status */
+	writel_relaxed(SPRD_SPI_ALL_INT_CLR, ss->base + SPRD_SPI_INT_CLR);
+
 	return 0;
 }
 
