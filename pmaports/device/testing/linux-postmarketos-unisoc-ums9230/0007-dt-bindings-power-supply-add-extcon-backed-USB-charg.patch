From bf626f83fbe90c0709e6a8bcc9f59c5cc7f7aa42 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Wed, 14 Oct 2026 12:28:17 +0800
Subject: [PATCH 1/2] dt-bindings: power: supply: add extcon-backed USB charger
 detection

A power supply that reports a USB charger, and its current limit, from what
an extcon device sees. It lets chargers that follow a supply through
ti,usb-charger-detection work on boards whose only detection is a VBUS pin.

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 .../supply/linux,extcon-charger-detect.yaml   | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/linux,extcon-charger-detect.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/linux,extcon-charger-detect.yaml b/Documentation/devicetree/bindings/power/supply/linux,extcon-charger-detect.yaml
new file mode 100644
index 000000000..320eb32c5
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/linux,extcon-charger-detect.yaml
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/linux,extcon-charger-detect.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: USB charger power supply backed by an extcon
+
+maintainers:
+  - Seuj09 <jeus110310@gmail.com>
+
+description:
+  Reports what an extcon device sees (VBUS, or the BC1.2 charger types) as a
+  USB power supply with a current limit. Chargers that follow such a supply,
+  like the TI bq2415x through ti,usb-charger-detection, use it to pick their
+  input current.
+
+properties:
+  compatible:
+    const: linux,extcon-charger-detect
+
+  extcon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: extcon device to follow.
+
+  default-microamp:
+    description: Limit for a standard downstream port or a plain VBUS extcon.
+    default: 500000
+
+  cdp-microamp:
+    description: Limit for a charging downstream port.
+    default: 1500000
+
+  dedicated-charger-microamp:
+    description: Limit for a dedicated charger.
+    default: 2000000
+
+required:
+  - compatible
+  - extcon
+
+additionalProperties: false
+
+examples:
+  - |
+    usb-charger-detect {
+        compatible = "linux,extcon-charger-detect";
+        extcon = <&vbus_extcon>;
+    };
+...
-- 
