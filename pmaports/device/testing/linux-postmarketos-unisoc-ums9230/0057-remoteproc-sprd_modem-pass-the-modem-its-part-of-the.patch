From 5759391959b031a644a4b706699da12a2e4f0379 Mon Sep 17 00:00:00 2001
From: ci <a@b>
Date: Sun, 1 Nov 2026 16:27:42 +0800
Subject: [PATCH] remoteproc: sprd_modem: pass the modem its part of the kernel
 command line

The stock kernel hands the modem RF board, crystal and clock options through
the cpcmdline region. The loader only cleared that region, so the modem booted
but never opened its sipc channels. Add an optional sprd,cp-cmdline property
and set it for the X6525.
---
 arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts |  5 +++++
 drivers/remoteproc/sprd_modem.c                    | 11 +++++++++++
 2 files changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
index ced0dc261..6c6ea4c3c 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
@@ -891,6 +891,11 @@ map0 {
 };
 
 &modem {
+	/*
+	 * The modem part of the stock kernel command line, which the stock
+	 * kernel copies to the modem's cpcmdline region.
+	 */
+	sprd,cp-cmdline = "modem=shutdown androidboot.mode=normal ltemode=lcsfb rfboard.id=2 rfhw.id=41008 crystal=6 32k.less=1 marlin.clktype=1 power.from.extern=0 androidboot.pmic.chipid=2730 cpcmdline=end";
 	status = "okay";
 };
 
diff --git a/drivers/remoteproc/sprd_modem.c b/drivers/remoteproc/sprd_modem.c
index 55689adf2..96594cd0d 100644
--- a/drivers/remoteproc/sprd_modem.c
+++ b/drivers/remoteproc/sprd_modem.c
@@ -48,6 +48,7 @@ struct sprd_modem {
 	phys_addr_t mem_base;
 	size_t mem_size;
 	void *bootmem;
+	const char *cp_cmdline;
 };
 
 struct sprd_modem_region_def {
@@ -98,6 +99,14 @@ static int sprd_modem_load_region(struct sprd_modem *m,
 
 	if (rdef->zero) {
 		memset(mem + (region_start - m->mem_base), 0, region_size);
+
+		/*
+		 * The stock kernel passes the modem its own part of the kernel
+		 * command line (RF board, crystal, ...) through this region.
+		 */
+		if (m->cp_cmdline && strlen(m->cp_cmdline) < region_size)
+			strscpy(mem + (region_start - m->mem_base),
+				m->cp_cmdline, region_size);
 	} else if (fw->size > region_size) {
 		if (rdef->filename)
 			release_firmware(fw);
@@ -257,6 +266,8 @@ static int sprd_modem_probe(struct platform_device *pdev)
 	m = rproc->priv;
 	m->dev = dev;
 
+	of_property_read_string(dev->of_node, "sprd,cp-cmdline", &m->cp_cmdline);
+
 	m->info = of_device_get_match_data(dev);
 	if (!m->info)
 		return -EINVAL;
-- 
