From 586c4dc747e0ff3593daa32c336513a9a20759da Mon Sep 17 00:00:00 2001
From: ci <a@b>
Date: Thu, 29 Oct 2026 18:42:10 +0800
Subject: [PATCH] media: sprd: add a bring-up driver for the UMS9230 video
 codec (VSP)

Powers the block (MM and VSP domains), enables its clocks, releases its
resets and dumps its first registers through debugfs. No decoding yet.
Adds the dt-bindings document.
---
 .../bindings/media/sprd,ums9230-vsp.yaml      |  90 ++++++++++
 drivers/media/platform/sprd/Kconfig           |   1 +
 drivers/media/platform/sprd/Makefile          |   1 +
 drivers/media/platform/sprd/vsp/Kconfig       |  15 ++
 drivers/media/platform/sprd/vsp/Makefile      |   5 +
 drivers/media/platform/sprd/vsp/vsp.c         | 157 ++++++++++++++++++
 6 files changed, 269 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/sprd,ums9230-vsp.yaml
 create mode 100644 drivers/media/platform/sprd/vsp/Kconfig
 create mode 100644 drivers/media/platform/sprd/vsp/Makefile
 create mode 100644 drivers/media/platform/sprd/vsp/vsp.c

diff --git a/Documentation/devicetree/bindings/media/sprd,ums9230-vsp.yaml b/Documentation/devicetree/bindings/media/sprd,ums9230-vsp.yaml
new file mode 100644
index 000000000..4fe23128a
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/sprd,ums9230-vsp.yaml
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/sprd,ums9230-vsp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Unisoc UMS9230 video codec (VSP)
+
+maintainers:
+  - Seuj09 <jeus110310@gmail.com>
+
+description:
+  The video codec block (VSP) of the Unisoc UMS9230 and related SoCs. It sits
+  in its own power domain behind the multimedia subsystem, is clocked from a
+  gate and a mux that selects one of three TWPLL outputs, and is reset by two
+  bits in the AP AHB register block.
+
+properties:
+  compatible:
+    const: sprd,ums9230-vsp
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Clock gate of the codec
+      - description: Codec clock (mux of the 256, 307.2 and 384 MHz TWPLL outputs)
+
+  clock-names:
+    items:
+      - const: enable
+      - const: codec
+
+  resets:
+    items:
+      - description: Global soft reset of the VSP
+      - description: Soft reset of the codec core
+
+  reset-names:
+    items:
+      - const: global
+      - const: core
+
+  power-domains:
+    items:
+      - description: Multimedia subsystem domain
+      - description: VSP domain
+
+  power-domain-names:
+    items:
+      - const: mm
+      - const: vsp
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - power-domains
+  - power-domain-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/clock/sprd,ums9230-clk.h>
+    #include <dt-bindings/reset/sprd,ums9230-reset.h>
+    #include <dt-bindings/power/sprd,ums9230-power.h>
+
+    video-codec@32000000 {
+        compatible = "sprd,ums9230-vsp";
+        reg = <0x32000000 0xc000>;
+        interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&apahb_gate CLK_VSP_EB>, <&ap_clk CLK_VSP>;
+        clock-names = "enable", "codec";
+        resets = <&apahb_gate RESET_AP_AHB_VSP_GLOBAL_SOFT_RST>,
+                 <&apahb_gate RESET_AP_AHB_VSP_SOFT_RST>;
+        reset-names = "global", "core";
+        power-domains = <&pmu UMS9230_POWER_DOMAIN_MM>,
+                        <&pmu UMS9230_POWER_DOMAIN_AP_VSP>;
+        power-domain-names = "mm", "vsp";
+    };
diff --git a/drivers/media/platform/sprd/Kconfig b/drivers/media/platform/sprd/Kconfig
index d9ebfc629..614c1138b 100644
--- a/drivers/media/platform/sprd/Kconfig
+++ b/drivers/media/platform/sprd/Kconfig
@@ -4,3 +4,4 @@ comment "Unisoc media platform drivers"
 
 source "drivers/media/platform/sprd/camsys/Kconfig"
 source "drivers/media/platform/sprd/isp/Kconfig"
+source "drivers/media/platform/sprd/vsp/Kconfig"
diff --git a/drivers/media/platform/sprd/Makefile b/drivers/media/platform/sprd/Makefile
index 6167ab2a4..c50497d55 100644
--- a/drivers/media/platform/sprd/Makefile
+++ b/drivers/media/platform/sprd/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0-only
 obj-y += camsys/
 obj-y += isp/
+obj-y += vsp/
diff --git a/drivers/media/platform/sprd/vsp/Kconfig b/drivers/media/platform/sprd/vsp/Kconfig
new file mode 100644
index 000000000..4ec04eaee
--- /dev/null
+++ b/drivers/media/platform/sprd/vsp/Kconfig
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config VIDEO_SPRD_VSP
+	tristate "Unisoc VSP video codec bring-up driver"
+	depends on ARCH_SPRD || COMPILE_TEST
+	depends on PM
+	depends on DEBUG_FS
+	select PM_GENERIC_DOMAINS
+	help
+	  Powers up the video codec block (VSP) of the Unisoc UMS9230 and
+	  exposes a register dump in debugfs. It does not decode anything
+	  yet; it is the first step towards a stateless V4L2 decoder.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called sprd-vsp.
diff --git a/drivers/media/platform/sprd/vsp/Makefile b/drivers/media/platform/sprd/vsp/Makefile
new file mode 100644
index 000000000..9260ac8ce
--- /dev/null
+++ b/drivers/media/platform/sprd/vsp/Makefile
@@ -0,0 +1,5 @@
+# SPDX-License-Identifier: GPL-2.0
+
+sprd-vsp-objs := vsp.o
+
+obj-$(CONFIG_VIDEO_SPRD_VSP) += sprd-vsp.o
diff --git a/drivers/media/platform/sprd/vsp/vsp.c b/drivers/media/platform/sprd/vsp/vsp.c
new file mode 100644
index 000000000..3698182ac
--- /dev/null
+++ b/drivers/media/platform/sprd/vsp/vsp.c
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Unisoc UMS9230 video codec (VSP): power, clock and reset bring-up.
+ *
+ * This only brings the block up and lets a developer look at its registers
+ * through debugfs. There is no decoding and no interrupt handling yet: the
+ * register map is not documented and has to be found out step by step.
+ *
+ * debugfs: /sys/kernel/debug/sprd-vsp/regs powers the block, pulses its
+ * reset and dumps the first VSP_DUMP_SIZE bytes of the register window.
+ */
+
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include <linux/seq_file.h>
+
+#define VSP_DUMP_SIZE	0x200
+
+struct sprd_vsp {
+	struct device *dev;
+	void __iomem *base;
+	struct clk_bulk_data clks[2];
+	struct reset_control_bulk_data rsts[2];
+	struct dev_pm_domain_list *pds;
+	struct dentry *dir;
+};
+
+static int sprd_vsp_runtime_resume(struct device *dev)
+{
+	struct sprd_vsp *vsp = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(vsp->clks), vsp->clks);
+	if (ret)
+		return ret;
+
+	ret = reset_control_bulk_deassert(ARRAY_SIZE(vsp->rsts), vsp->rsts);
+	if (ret)
+		clk_bulk_disable_unprepare(ARRAY_SIZE(vsp->clks), vsp->clks);
+
+	return ret;
+}
+
+static int sprd_vsp_runtime_suspend(struct device *dev)
+{
+	struct sprd_vsp *vsp = dev_get_drvdata(dev);
+
+	reset_control_bulk_assert(ARRAY_SIZE(vsp->rsts), vsp->rsts);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(vsp->clks), vsp->clks);
+
+	return 0;
+}
+
+static int sprd_vsp_regs_show(struct seq_file *s, void *unused)
+{
+	struct sprd_vsp *vsp = s->private;
+	int ret, i;
+
+	ret = pm_runtime_resume_and_get(vsp->dev);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < VSP_DUMP_SIZE; i += 16)
+		seq_printf(s, "%04x: %08x %08x %08x %08x\n", i,
+			   readl(vsp->base + i), readl(vsp->base + i + 4),
+			   readl(vsp->base + i + 8), readl(vsp->base + i + 12));
+
+	pm_runtime_put(vsp->dev);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(sprd_vsp_regs);
+
+static int sprd_vsp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sprd_vsp *vsp;
+	int ret;
+
+	vsp = devm_kzalloc(dev, sizeof(*vsp), GFP_KERNEL);
+	if (!vsp)
+		return -ENOMEM;
+
+	vsp->dev = dev;
+	platform_set_drvdata(pdev, vsp);
+
+	vsp->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(vsp->base))
+		return PTR_ERR(vsp->base);
+
+	vsp->clks[0].id = "enable";
+	vsp->clks[1].id = "codec";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(vsp->clks), vsp->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the clocks\n");
+
+	vsp->rsts[0].id = "global";
+	vsp->rsts[1].id = "core";
+	ret = devm_reset_control_bulk_get_exclusive(dev, ARRAY_SIZE(vsp->rsts),
+						    vsp->rsts);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the resets\n");
+
+	/* both the multimedia and the VSP domain have to be on */
+	ret = devm_pm_domain_attach_list(dev, NULL, &vsp->pds);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to attach the power domains\n");
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	vsp->dir = debugfs_create_dir("sprd-vsp", NULL);
+	debugfs_create_file("regs", 0400, vsp->dir, vsp, &sprd_vsp_regs_fops);
+
+	dev_info(dev, "video codec ready; cat /sys/kernel/debug/sprd-vsp/regs powers it and dumps its registers\n");
+
+	return 0;
+}
+
+static void sprd_vsp_remove(struct platform_device *pdev)
+{
+	struct sprd_vsp *vsp = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(vsp->dir);
+}
+
+static const struct dev_pm_ops sprd_vsp_pm_ops = {
+	SET_RUNTIME_PM_OPS(sprd_vsp_runtime_suspend, sprd_vsp_runtime_resume, NULL)
+};
+
+static const struct of_device_id sprd_vsp_of_match[] = {
+	{ .compatible = "sprd,ums9230-vsp" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sprd_vsp_of_match);
+
+static struct platform_driver sprd_vsp_driver = {
+	.probe = sprd_vsp_probe,
+	.remove = sprd_vsp_remove,
+	.driver = {
+		.name = "sprd-vsp",
+		.of_match_table = sprd_vsp_of_match,
+		.pm = &sprd_vsp_pm_ops,
+	},
+};
+module_platform_driver(sprd_vsp_driver);
+
+MODULE_DESCRIPTION("Unisoc UMS9230 video codec (VSP) bring-up driver");
+MODULE_LICENSE("GPL");
