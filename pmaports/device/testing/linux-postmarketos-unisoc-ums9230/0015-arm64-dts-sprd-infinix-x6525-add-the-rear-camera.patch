From 917cc7a482c97ccf3f954c5c8bef947484cb0e68 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sat, 24 Oct 2026 10:42:13 +0000
Subject: [PATCH] arm64: dts: sprd: add the rear camera to the Infinix X6525

The stock system identifies the rear module as an S5K3L6 (slot 0,
"s5k3l6_1836_13M") and opens it over four MIPI data lanes at 4208x3120.

The live device tree from the phone (not the generic vendor overlay) puts
that module in the sensor-sub socket: i2c1 at reg 0x5a - the 8-bit form of
the S5K3L6's 0x2d address - with reset on ap_gpio 41, power-down on ap_gpio
40, AVDD from vddcama1, DVDD from vddcamd1, I/O from vddcamio, CLK_SENSOR1
at 24 MHz, and sprd,phyid 0 (the four-lane port).

The front OV8856 sits in the other socket (i2c0, 0x10, phyid 2); it is not
described yet.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 .../boot/dts/sprd/ums9230-infinix-x6525.dts   | 76 +++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
index 08f494f0d..1bb9c700f 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
@@ -30,6 +30,7 @@
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/media/sprd-camsys.h>
 #include <dt-bindings/usb/pd.h>
 
 #include "ums9230.dtsi"
@@ -526,6 +527,81 @@ &sc2730_fgu {
 	status = "okay";
 };
 
+/* ---- camera -------------------------------------------------------------
+ * The stock system identifies the rear sensor as an S5K3L6: slot 0 reports
+ * "s5k3l6_1836_13M" in vendor.cam.sensor.slot.info, and the stock camera HAL
+ * opens it at 4208x3120 over four MIPI data lanes (camioctl_sensor_if_set:
+ * "mipi 0 10 0 4").
+ *
+ * The live device tree (unit-data/bin/fdt.dtb, copied from /sys/firmware/fdt
+ * on the stock system) puts it in the sensor-sub socket: i2c1, reg 0x5a -
+ * the 8-bit form of the S5K3L6's 0x2d address - reset on ap_gpio 41,
+ * power-down on ap_gpio 40, AVDD from vddcama1, DVDD from vddcamd1, I/O from
+ * vddcamio, and CLK_SENSOR1 (sprd,phyid 0, so the four-lane port).
+ *
+ * The driver's register tables are extracted from the vendor's own sensor
+ * library (libsensor_s5k3l6.so, "s5k3l6_v1"); it runs the part at a 24 MHz
+ * MCLK with four lanes and the three modes below.
+ *
+ * The front camera is an OV8856 in the sensor-main socket (i2c0, reg 0x20,
+ * i.e. 0x10, sprd,phyid 2); it is not described yet. The sensor-main2 socket
+ * is the decorative second rear lens ("fakeserial" in the HAL).
+ */
+&i2c1 {
+	status = "okay";
+	clock-frequency = <400000>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	camera@2d {
+		compatible = "samsung,s5k3l6";
+		reg = <0x2d>;
+		reset-gpios = <&ap_gpio 41 GPIO_ACTIVE_LOW>;
+		power-down-gpios = <&ap_gpio 40 GPIO_ACTIVE_HIGH>;
+
+		clocks = <&mm_gate CLK_MM_SENSOR1_EB>;
+		clock-names = "mclk";
+		assigned-clocks = <&mm_clk CLK_SENSOR1>;
+		assigned-clock-parents = <&pll1 CLK_TWPLL_48M>;
+		assigned-clock-rates = <24000000>;
+
+		vddio-supply = <&vddcamio>;
+		vdda-supply = <&vddcama1>;
+		vddd-supply = <&vddcamd1>;
+
+		rotation = <90>;
+		orientation = <1>;
+
+		port {
+			s5k3l6_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64
+					<600000000 284000000 153000000>;
+				remote-endpoint = <&csi_4lane_ep>;
+			};
+		};
+	};
+};
+
+&camsys {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 4-lane port: the rear camera */
+		port@CAMSYS_CSI_4LANE {
+			reg = <CAMSYS_CSI_4LANE>;
+
+			csi_4lane_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&s5k3l6_ep>;
+			};
+		};
+	};
+};
+
 /* ---- display ------------------------------------------------------------
  * Confirmed on the device's own cmdline: lcd_name=lcd_td4160_hx_mipi_hdp_x6525,
  * i.e. the TD4160 HX variant at 720x1612. No mainline driver exists for it yet;
