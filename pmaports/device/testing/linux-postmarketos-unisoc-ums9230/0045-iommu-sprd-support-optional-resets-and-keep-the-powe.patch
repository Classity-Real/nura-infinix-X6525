From d4d83b3e289104de75a780fbc86802459e929946 Mon Sep 17 00:00:00 2001
From: ci <a@b>
Date: Fri, 30 Oct 2026 03:15:54 +0800
Subject: [PATCH] iommu: sprd: support optional resets and keep the power
 domain on while bound

The VSP's IOMMU sits in a power domain and in a block that must be out of reset before
its registers read back correctly (a block in reset reads version 0, which the driver
would take for the EX register layout). Get the resets (shared with the client), take a
runtime PM reference for the lifetime of the binding, and release the resets before
reading the version. Documented in the binding.
---
 .../devicetree/bindings/iommu/sprd,iommu.yaml |  9 ++++
 drivers/iommu/sprd-iommu.c                    | 41 ++++++++++++++++++-
 2 files changed, 48 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/iommu/sprd,iommu.yaml b/Documentation/devicetree/bindings/iommu/sprd,iommu.yaml
index 5414689bd..94c1858d9 100644
--- a/Documentation/devicetree/bindings/iommu/sprd,iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/sprd,iommu.yaml
@@ -31,7 +31,16 @@ properties:
       Reference to a gate clock phandle, since access to some of IOMMUs are
       controlled by gate clock, but this is not required.
 
+  resets:
+    description:
+      Resets of the block the IOMMU is part of, released before the IOMMU is
+      used. They may be shared with the IOMMU's client.
+
+  power-domains:
+    maxItems: 1
+
   sprd,iova-range:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
     minItems: 2
     maxItems: 2
     description:
diff --git a/drivers/iommu/sprd-iommu.c b/drivers/iommu/sprd-iommu.c
index 1f33afe67..31fe3d0bc 100644
--- a/drivers/iommu/sprd-iommu.c
+++ b/drivers/iommu/sprd-iommu.c
@@ -16,7 +16,9 @@
 #include <linux/of_iommu.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
 #include <linux/regmap.h>
+#include <linux/reset.h>
 #include <linux/slab.h>
 
 #define SPRD_IOMMU_PAGE_SHIFT	12
@@ -62,6 +64,7 @@ enum sprd_iommu_version {
  * @iommu: IOMMU core representation
  * @group: IOMMU group
  * @eb: gate clock which controls IOMMU access
+ * @rst: optional (shared) reset of the block the IOMMU is part of
  */
 struct sprd_iommu_device {
 	struct sprd_iommu_domain	*dom;
@@ -74,6 +77,7 @@ struct sprd_iommu_device {
 	struct device		*dev;
 	struct iommu_device	iommu;
 	struct clk		*eb;
+	struct reset_control	*rst;
 };
 
 struct sprd_iommu_domain {
@@ -529,14 +533,40 @@ static int sprd_iommu_probe(struct platform_device *pdev)
 	platform_set_drvdata(pdev, sdev);
 	sdev->dev = dev;
 
-	ret = sprd_iommu_clk_enable(sdev);
+	/*
+	 * Some IOMMUs sit in a power domain and in a block that has to be
+	 * released from reset before their registers read back correctly (a
+	 * block still in reset reads as version 0, which would be taken for the
+	 * other register layout). Keep the domain powered while the IOMMU is
+	 * bound: its page table registers are accessed whenever a client maps
+	 * memory.
+	 */
+	ret = devm_pm_runtime_enable(dev);
 	if (ret)
 		goto free_page;
 
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		goto free_page;
+
+	ret = sprd_iommu_clk_enable(sdev);
+	if (ret)
+		goto put_pm;
+
+	sdev->rst = devm_reset_control_array_get_optional_shared(dev);
+	if (IS_ERR(sdev->rst)) {
+		ret = dev_err_probe(dev, PTR_ERR(sdev->rst), "failed to get the resets\n");
+		goto disable_clk;
+	}
+
+	ret = reset_control_deassert(sdev->rst);
+	if (ret)
+		goto disable_clk;
+
 	ret = sprd_iommu_get_version(sdev);
 	if (ret < 0) {
 		dev_err(dev, "IOMMU version(%d) is invalid.\n", ret);
-		goto disable_clk;
+		goto assert_rst;
 	}
 	sdev->ver = ret;
 
@@ -552,8 +582,12 @@ static int sprd_iommu_probe(struct platform_device *pdev)
 
 remove_sysfs:
 	iommu_device_sysfs_remove(&sdev->iommu);
+assert_rst:
+	reset_control_assert(sdev->rst);
 disable_clk:
 	sprd_iommu_clk_disable(sdev);
+put_pm:
+	pm_runtime_put(dev);
 free_page:
 	dma_free_coherent(sdev->dev, SPRD_IOMMU_PAGE_SIZE, sdev->prot_page_va, sdev->prot_page_pa);
 	return ret;
@@ -568,6 +602,9 @@ static void sprd_iommu_remove(struct platform_device *pdev)
 	platform_set_drvdata(pdev, NULL);
 	iommu_device_unregister(&sdev->iommu);
 	iommu_device_sysfs_remove(&sdev->iommu);
+	reset_control_assert(sdev->rst);
+	sprd_iommu_clk_disable(sdev);
+	pm_runtime_put(&pdev->dev);
 }
 
 static struct platform_driver sprd_iommu_driver = {
