# Staging for the Infinix X6525: the twenty-seven patches below add this board
# (device tree, panel, touch, charger and camera sensor drivers, the bindings
# they need, two binding fixes, a watchdog fix, a Bluetooth fallback and the
# charger's OTG boost regulator) and are cut against the same tag this package
# builds from. They come back out
# once the series is merged upstream - see the port repository's
# pmaports/README.md and patches/upstream/. Everything else is unchanged.
maintainer="Affe Null <affenull2345@gmail.com>"
_flavor="postmarketos-unisoc-ums9230"
pkgname=linux-$_flavor
pkgver=7.2.0_rc6_git20260807
pkgrel=24
pkgdesc="Linux kernel with patches for Unisoc UMS9230 devices"
arch="aarch64"
_carch="arm64"
url="https://codeberg.org/ums9230-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	pmb:kconfigcheck-community
"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

_tag="v7.2-rc6-ums9230-0"
_config="config-$_flavor.$arch"
source="
	linux-$_tag.tar.gz::https://codeberg.org/ums9230-mainline/linux/archive/$_tag.tar.gz
	$_config
	0001-dt-bindings-vendor-prefixes-add-Infinix-Mobility.patch
	0002-dt-bindings-arm-sprd-add-Infinix-X6525-board.patch
	0003-arm64-dts-sprd-add-device-tree-for-Infinix-X6525.patch
	0004-drm-panel-add-driver-for-the-TD4160-HX-720x1612-panel.patch
	0005-dt-bindings-input-add-OmniVision-TCM-SPI-touchscreen.patch
	0006-Input-add-OmniVision-TCM-SPI-touchscreen-driver-host.patch
	0007-dt-bindings-power-supply-add-extcon-backed-USB-charg.patch
	0008-power-supply-add-extcon-backed-USB-charger-detection.patch
	0009-dt-bindings-gpio-sprd-allow-gpio-hog-nodes.patch
	0010-dt-bindings-power-supply-sc27xx-fg-allow-power-suppl.patch
	0011-watchdog-sprd_wdt-keep-a-watchdog-the-bootloader-started-fed.patch
	0012-spi-sprd-fix-full-duplex-pio-rx-length-and-irq-clear.patch
	0013-bluetooth-btsprdsipc-fall-back-to-a-random-bd-address.patch
	0028-Bluetooth-btsprdsipc-reject-a-pskey-config-shorter-t.patch
	0014-media-i2c-add-a-Samsung-S5K3L6-sensor-driver.patch
	0015-arm64-dts-sprd-infinix-x6525-add-the-rear-camera.patch
	0016-power-supply-bq2415x-expose-the-OTG-boost-as-a-regulator.patch
	0017-arm64-dts-sprd-infinix-x6525-charger-otg-boost.patch
	0018-arm64-dts-sprd-infinix-x6525-gpu-dvfs.patch
	0019-drm-panel-td4160-hx-90hz.patch
	0020-arm64-dts-sprd-boot-the-X6525-s-UFS-units-too.patch
	0021-arm64-dts-sprd-infinix-x6525-add-the-front-camera.patch
	0022-arm64-dts-sprd-infinix-x6525-gpu-thermal-throttling.patch
	0023-mmc-sdhci-sprd-opt-in-hs200-override.patch
	0024-drm-panel-td4160-hx-keep-the-stock-60hz-preferred.patch
	0025-drm-panel-td4160-hx-fix-post-command-delays-and-powe.patch
	0026-drm-sprd-enable-LP-cmd-tx-and-clean-boot-handoff.patch
	0027-mmc-core-disable-volatile-eMMC-cache-by-default-and-.patch
"
builddir="$srcdir/linux"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

