# Reference: <https://postmarketos.org/devicepkg>
maintainer="Seuj09 <jeus110310@gmail.com>"
pkgname=device-infinix-x6525
pkgdesc="Infinix X6525"
pkgver=1
pkgrel=12
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools
	firmware-infinix-x6525
	linux-postmarketos-unisoc-ums9230
	postmarketos-base
	soc-unisoc-ums9230
	u-boot-infinix-x6525
"
# u-boot-infinix-x6525 is not optional: U-Boot is chainloaded from boot_a, so
# without it there is no way to boot the device at all (its u-boot.bin and the
# dummy initramfs below make up the boot image).
#
# android-tools is not optional either, though it looks like it: boot-deploy
# builds that boot image with mkbootimg, finds it in android-tools, and refuses
# to run at all - "deviceinfo_generate_bootimg is set, but the package
# android-tools was not" - which fails mkinitfs, and with it the whole install.
# device-jolla-c2, the same SoC the same way, depends on it for this reason.
#
# The touch controller has no flash, so its HDL image has to be in both the
# initramfs (for buffyboard / FDE) and rootfs for the touchscreen to work at
# all - hence depending on firmware-infinix-x6525 so it is unpacked before
# mkinitfs runs.
makedepends="devicepkg-dev"
# kernel-cmdline.conf goes to /usr/lib/kernel-cmdline.d/50-$pkgname.conf
# (devicepkg-dev installs it; boot-deploy reads it via generate-kernel-cmdline).
# It carries loglevel=7 for the first boot: the distro config ships `quiet`, and
# a later loglevel= is what wins, so the kernel prints its messages anyway. It also
# names both consoles: with the DT's stdout-path alone only the UART is a console,
# so nothing the kernel prints reaches the screen (tty0 is only enabled when no
# console is preferred); naming console= turns stdout-path off, so the UART (the
# last one, which becomes /dev/console) has to be named too. The extlinux line
# otherwise carries `quiet splash plymouth.*`, and plymouth would cover the
# console, so plymouth.enable=0 and nosplash (the shipped initramfs's init_2nd.sh
# honours the latter) keep the kernel messages visible. clk_ignore_unused and
# pd_ignore_unused stop the kernel gating, 30 s in, the clocks and power domains
# the bootloader left running for the display (and bus masters) that no driver has
# claimed yet - the screen would go black exactly when the DPU stack failed to take over.
# DEBUG BUILD: initcall_blacklist=sprd_drm_init keeps the DPU/DSI driver from loading so
# the framebuffer the bootloader left running (simpledrm) is the only display and
# nothing can blank it; ignore_loglevel and initcall_debug put every initcall on
# screen so a hang shows where it stopped. pmos.debug-shell starts the initramfs's telnet
# shell on the USB network (172.16.42.1) and console=tty0 is listed LAST so that /dev/console,
# where init prints, is the screen and not the UART. Remove all of these once the boot works.
# cpuidle.off=1 cpufreq.off=1: with them on, a CPU (it varied) stopped taking timer interrupts
# and RCU stalled forever (rcu_preempt kthread starved); with them off the boot is stable. Which
# of the two is the cause is not known yet. regulator_ignore_unused keeps the touch controller's
# 2.8 V rail (vddldo0) on past the 30 s regulator cleanup; the DT also marks it always-on.
# The 5-minute reset was the PMIC watchdog, which U-Boot's `pmicwdt stop` disarms (u-boot package).
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname

	# Generate a dummy initramfs for the chainloadable U-Boot image
	fallocate -l 4k dummy-initramfs
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 dummy-initramfs \
		"$pkgdir"/usr/share/u-boot/infinix-x6525/dummy-initramfs

	mkdir -p "$pkgdir"/usr/share/mkinitfs/files
	echo "/lib/firmware/postmarketos/sprd/hdl_firmware_01.img" \
		> "$pkgdir"/usr/share/mkinitfs/files/30-device-infinix-x6525.files
}

