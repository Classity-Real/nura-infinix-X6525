# Reference: <https://postmarketos.org/devicepkg>
maintainer="Seuj09 <jeus110310@gmail.com>"
pkgname=device-infinix-x6525
pkgdesc="Infinix X6525"
pkgver=1
pkgrel=21
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools
	bluez
	firmware-infinix-x6525
	iw
	linux-postmarketos-unisoc-ums9230
	mesa-vulkan-panfrost
	mmc-utils
	networkmanager-wifi
	postmarketos-base
	soc-unisoc-ums9230
	u-boot-infinix-x6525
	wireless-regdb
	wpa_supplicant
"
# iw, wpa_supplicant, wireless-regdb and networkmanager-wifi are the Wi-Fi userspace for the
# built-in chip (sc23xx_wlan, a cfg80211 driver): NetworkManager drives it through
# wpa_supplicant, and cfg80211 needs the regulatory database or it stays at the world domain.
#
# u-boot-infinix-x6525 is not optional: U-Boot is chainloaded from boot_a, so
# without it there is no way to boot the device at all (its u-boot.bin and the
# dummy initramfs below make up the boot image).
#
# android-tools is not optional either, though it looks like it: boot-deploy
# builds that boot image with mkbootimg, finds it in android-tools, and refuses
# to run at all - "deviceinfo_generate_bootimg is set, but the package
# android-tools was not" - which fails mkinitfs, and with it the whole install.
# device-jolla-c2, the same SoC the same way, depends on it for this reason.
#
# The touch controller has no flash, so its HDL image has to be in both the
# initramfs (for buffyboard / FDE) and rootfs for the touchscreen to work at
# all - hence depending on firmware-infinix-x6525 so it is unpacked before
# mkinitfs runs.
makedepends="devicepkg-dev"
# kernel-cmdline.conf goes to /usr/lib/kernel-cmdline.d/50-$pkgname.conf
# (devicepkg-dev installs it; boot-deploy reads it via generate-kernel-cmdline).
# It carries loglevel=7 for the first boot: the distro config ships `quiet`, and
# a later loglevel= is what wins, so the kernel prints its messages anyway. It also
# names both consoles: with the DT's stdout-path alone only the UART is a console,
# so nothing the kernel prints reaches the screen (tty0 is only enabled when no
# console is preferred); naming console= turns stdout-path off, so the UART (the
# last one, which becomes /dev/console) has to be named too. The extlinux line
# otherwise carries `quiet splash plymouth.*`, and plymouth would cover the
# console, so plymouth.enable=0 and nosplash (the shipped initramfs's init_2nd.sh
# honours the latter) keep the kernel messages visible. clk_ignore_unused and
# pd_ignore_unused stop the kernel gating, 30 s in, the clocks and power domains
# the bootloader left running for the display (and bus masters) that no driver has
# claimed yet - the screen would go black exactly when the DPU stack failed to take over.
# The DPU/DSI stack is enabled: initcall_blacklist=sprd_drm_init is gone now that the GUI
# work needs it - the panel driver only probes with sprd_drm, and that driver registers
# /sys/class/backlight/td4160 (the DCS brightness control) and reports the 68x152 mm panel
# size that gives Phosh its automatic 2x output scale. simpledrm remains the fallback until
# sprd_drm has taken over. ignore_loglevel and initcall_debug stay for the bring-up: they
# put every initcall on screen so a hang shows where it stopped. console=tty0 is listed LAST
# so /dev/console, where init prints, is the screen and not the UART. pmos.debug-shell is
# deliberately not set: its continue path removes the USB ACM function and re-binds the UDC,
# which hangs on this controller - hold volume-down at boot for the debug shell instead
# (the initramfs check_keys path).
# cpuidle.off=1 cpufreq.off=1: with them on, a CPU (it varied) stopped taking timer interrupts
# and RCU stalled forever (rcu_preempt kthread starved); with them off the boot is stable. Which
# of the two is the cause is not known yet. regulator_ignore_unused keeps the touch controller's
# 2.8 V rail (vddldo0) on past the 30 s regulator cleanup; the DT also marks it always-on.
# The 5-minute reset was the PMIC watchdog, which U-Boot's `pmicwdt stop` disarms (u-boot package).
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname

	# Generate a dummy initramfs for the chainloadable U-Boot image
	fallocate -l 4k dummy-initramfs
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 dummy-initramfs \
		"$pkgdir"/usr/share/u-boot/infinix-x6525/dummy-initramfs

	mkdir -p "$pkgdir"/usr/share/mkinitfs/files
	echo "/lib/firmware/postmarketos/sprd/hdl_firmware_01.img" \
		> "$pkgdir"/usr/share/mkinitfs/files/30-device-infinix-x6525.files

	# Built-in Wi-Fi and Bluetooth. The remoteproc (loads sprd/wcnmodem.bin) and
	# the WLAN driver (downloads sprd/wifi_board_config.bin) are modules living
	# in the rootfs, so they are loaded explicitly here once the root filesystem
	# is up; btsprdsipc is the Bluetooth transport over the same WCN SIPC link.
	mkdir -p "$pkgdir"/usr/lib/modules-load.d
	printf '%s\n' sprd_wcn sc23xx_wlan sc23xx_wlan_sipc btsprdsipc \
		> "$pkgdir"/usr/lib/modules-load.d/x6525-wifi.conf

	# Start BlueZ on boot. The image's 90-base.preset enables bluetooth.service
	# and so does 90-infinix-x6525.preset below; this symlink is belt and
	# braces for a path where the preset trigger does not run. The unit comes
	# from the bluez dependency above.
	mkdir -p "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -s /usr/lib/systemd/system/bluetooth.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/bluetooth.service
	# The cellular modem's images are on this phone, not in the package: the
	# NV in particular is per unit and carries the IMEI, so shipping it in a
	# public port would publish it. The kernel asks for sprd/l_*.bin, so a
	# oneshot unit copies each image out of its partition first (trimmed to the
	# region size the main image's MECP header declares) and only then loads
	# the driver. sprd_modem is blacklisted from coldplug for that reason.
	install -Dm755 /dev/stdin "$pkgdir"/usr/bin/x6525-modem-nv <<'EOF'
#!/bin/sh
# Copy this phone's own modem images from its partitions into /lib/firmware/sprd.
#
# The port does not ship them: the NV carries the unit's IMEI, and the rest are
# vendor images that live on the device anyway. Each file is the first <size>
# bytes of its partition - the region size the main image's MECP header
# declares (BRING_UP_CHECKLIST.md 5.2).
set -u

dst=/lib/firmware/sprd
by=/dev/disk/by-partlabel
mkdir -p "$dst"

copy() {
	label=$1
	file=$2
	size=$3

	if [ -s "$dst/$file" ] && [ "$(stat -c %s "$dst/$file")" = "$size" ]; then
		return 0
	fi
	if [ ! -e "$by/$label" ]; then
		echo "x6525-modem-nv: no $label partition" >&2
		return 1
	fi
	if ! dd if="$by/$label" of="$dst/.$file.tmp" bs=4096 \
			count=$((size / 4096)) status=none; then
		echo "x6525-modem-nv: could not read $label" >&2
		rm -f "$dst/.$file.tmp"
		return 1
	fi
	mv "$dst/.$file.tmp" "$dst/$file"
}

rc=0
copy l_modem_a l_modem.bin 20447232 || rc=1
copy l_deltanv_a l_deltanv.bin 131072 || rc=1
copy l_fixnv1_a l_fixnv.bin 1048576 || rc=1
copy l_runtimenv1 l_runtimenv.bin 1179648 || rc=1
copy l_gdsp_a l_gdsp.bin 4456448 || rc=1
copy l_ldsp_a l_ldsp.bin 11534336 || rc=1
exit $rc
EOF

	install -Dm644 /dev/stdin \
		"$pkgdir"/usr/lib/systemd/system/x6525-modem-nv.service <<'EOF'
[Unit]
Description=Extract this phone's modem images from its own partitions
After=local-fs.target
Before=network-pre.target modemmanager.service
ConditionPathExists=/dev/disk/by-partlabel/l_modem_a

[Service]
Type=oneshot
# - : a unit with a different partition layout must still boot; the modem then
# fails to load its firmware instead of the boot stopping.
ExecStart=-/usr/bin/x6525-modem-nv
# sprd_modem is blacklisted, so this is the only place it gets loaded, and the
# rpmsg/WWAN modules follow from the devices it creates.
ExecStart=/sbin/modprobe sprd_modem
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

	install -Dm644 /dev/stdin "$pkgdir"/etc/modprobe.d/x6525-modem.conf <<'EOF'
# The modem's firmware is extracted from this unit's partitions by
# x6525-modem-nv.service. Until that has run, the driver must not probe.
blacklist sprd_modem
EOF

	mkdir -p "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -s /usr/lib/systemd/system/x6525-modem-nv.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/x6525-modem-nv.service

	# The device tree's local-mac-address for the WLAN channel is all zeroes
	# ("filled in by bootloader"); U-Boot fills it from its wifiaddr environment
	# variable, which is unset on this board, so it stays zero and the interface
	# would come up with 00:00:00:00:00:00. Give it a random locally
	# administered address, generated once and kept, as soon as the interface
	# exists.
	install -Dm755 /dev/stdin "$pkgdir"/usr/bin/x6525-wlan-mac <<'EOF'
#!/bin/sh
# usage: x6525-wlan-mac <ifname>
f=/var/lib/x6525/wlan-mac
mkdir -p /var/lib/x6525
if [ ! -s "$f" ]; then
	od -An -N5 -tx1 /dev/urandom | awk '{printf "02:%s:%s:%s:%s:%s\n", $1,$2,$3,$4,$5}' > "$f"
fi
cur=$(cat /sys/class/net/"$1"/address 2>/dev/null)
[ "$cur" = "00:00:00:00:00:00" ] || exit 0
ip link set dev "$1" address "$(cat "$f")"
EOF
	install -Dm644 /dev/stdin "$pkgdir"/usr/lib/udev/rules.d/90-x6525-wlan-mac.rules <<'EOF'
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan*", RUN+="/usr/bin/x6525-wlan-mac %k"
EOF

	# The eMMC's write-back cache is what turns a forced power-off into ext4
	# metadata the journal cannot replay ("Inode N seems to contain garbage",
	# then a manual fsck at boot). Disable the card's cache at the EXT_CSD
	# level instead of only changing the block queue's write_cache flag: the
	# latter also stops the kernel from sending flush barriers, while the
	# card would still cache writes. This trades write throughput for forced
	# power-offs staying journal-recoverable. CACHE_CTRL is not persistent,
	# so the service runs every boot, early, before much has been written.
	install -Dm644 /dev/stdin \
		"$pkgdir"/usr/lib/systemd/system/x6525-emmc-cacheoff.service <<'EOF'
[Unit]
Description=Disable the eMMC write cache (power-loss safety)
DefaultDependencies=no
After=systemd-udevd.service
Before=sysinit.target
ConditionPathExists=/dev/mmcblk0

[Service]
Type=oneshot
ExecStartPre=-/usr/bin/mmc cache flush /dev/mmcblk0
ExecStart=-/usr/bin/mmc cache disable /dev/mmcblk0
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
EOF
	mkdir -p "$pkgdir"/etc/systemd/system/sysinit.target.wants
	ln -s /usr/lib/systemd/system/x6525-emmc-cacheoff.service \
		"$pkgdir"/etc/systemd/system/sysinit.target.wants/x6525-emmc-cacheoff.service

	# Belt and braces for the case where the card refuses cache disable: flush
	# the card's cache after the usual services have stopped but while the
	# root is still writable, before systemd unmounts or cuts power. This is
	# the layer that covers a *clean* Power Off, the path that lost the cache.
	install -Dm644 /dev/stdin \
		"$pkgdir"/usr/lib/systemd/system/x6525-emmc-flush.service <<'EOF'
[Unit]
Description=Flush the eMMC cache on shutdown
DefaultDependencies=no
After=local-fs.target
Before=shutdown.target reboot.target halt.target kexec.target
ConditionPathExists=/dev/mmcblk0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=-/usr/bin/mmc cache flush /dev/mmcblk0

[Install]
WantedBy=multi-user.target
EOF
	mkdir -p "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -s /usr/lib/systemd/system/x6525-emmc-flush.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/x6525-emmc-flush.service

	# Enabling a unit with a symlink created here does not survive the image
	# build: pmOS's systemd-apk-trigger runs `systemctl preset` for every
	# newly installed unit that has an [Install] section, and 99-default.preset
	# is `disable *`. That is what happened to these two units in every image
	# up to pkgrel 18 - `/usr/lib/systemd/system/` had them, the build log said
	# `Removed '/etc/systemd/system/sysinit.target.wants/x6525-emmc-cacheoff.service'`,
	# and the cache fix never ran on the phone. Preset files are read in name
	# order and the first matching rule wins (which is why 90-base.preset's
	# `enable` beats 99-default.preset's `disable *`), so 90-* is early enough.
	# The symlinks above stay as well: the trigger skips a unit that is both
	# added and removed in its diff (a modified file), so on an incremental
	# build where the unit's content changed the preset is not applied and the
	# package's own symlink is what enables it.
	# bluetooth.service is here for the same reason: 90-base.preset enables it
	# today, and this keeps that true if that policy changes.
	install -Dm644 /dev/stdin \
		"$pkgdir"/usr/lib/systemd/system-preset/90-infinix-x6525.preset <<'EOF'
enable x6525-emmc-cacheoff.service
enable x6525-emmc-flush.service
enable bluetooth.service
enable x6525-modem-nv.service
EOF

	# For the phosh build (the device package serves both UIs): point the
	# session at the real panel (sprd-drm) instead of the bootloader's
	# simpledrm. Only the panel driver registers the DCS backlight and reports
	# the 68x152 mm size that gives the 2x output scale. simpledrm stays as the
	# console fallback; the symlink the drop-in names is created by a udev rule
	# only when a sprd-drm card exists.
	#
	# The renderer is pinned to software in a separate drop-in (20-x6525-
	# software-render.conf, below). Left unpinned, wlroots tries GLES2 through
	# Panfrost first, and on this board that leaves the screen black once the
	# session starts (the session is up and SSH works, but nothing is drawn).
	# Delete that one file to try the GPU again; this one is the display
	# choice and stays.
	install -Dm644 /dev/stdin "$pkgdir"/etc/systemd/system/greetd.service.d/10-x6525-software.conf <<'EOF'
[Service]
# Drive the real panel (sprd-drm), not the bootloader's simpledrm: only the
# panel driver registers the DCS backlight and reports the 68x152 mm size
# that gives the 2x scale. simpledrm stays as the console fallback; the
# symlink is created below only when a sprd-drm card exists.
Environment=WLR_DRM_DEVICES=/dev/dri/x6525-primary
# The renderer is chosen in 20-x6525-software-render.conf.
EOF

	# Software rendering for the phosh session. Three layers, because each one
	# picks its own renderer:
	#   WLR_RENDERER=pixman       phoc (wlroots) composes on the CPU instead of
	#                             through Panfrost GLES2/Vulkan;
	#   LIBGL_ALWAYS_SOFTWARE=1   Mesa clients (GL/GLES/EGL apps) use llvmpipe.
	#                             Needed together with the line above: a pixman
	#                             compositor offers no linux-dmabuf, so a client
	#                             that picked the GPU would have nothing to
	#                             share its buffers with;
	#   GSK_RENDERER=cairo        GTK4 apps (phosh itself, the greeter, most of
	#                             the GNOME mobile apps) draw with cairo rather
	#                             than going through GL at all.
	# To use the GPU again: rm /etc/systemd/system/greetd.service.d/20-x6525-software-render.conf
	# and reboot.
	install -Dm644 /dev/stdin "$pkgdir"/etc/systemd/system/greetd.service.d/20-x6525-software-render.conf <<'EOF'
[Service]
Environment=WLR_RENDERER=pixman
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=GSK_RENDERER=cairo
EOF
	# The same variables for the user's systemd services and anything started
	# outside the greetd session (environment.d is read by systemd --user).
	install -Dm644 /dev/stdin "$pkgdir"/etc/environment.d/20-x6525-software-render.conf <<'EOF'
LIBGL_ALWAYS_SOFTWARE=1
GSK_RENDERER=cairo
EOF

	# One command that gathers what is needed to tell a black screen's causes
	# apart, written to a file so it can be read over SSH or sent back as it is.
	install -Dm755 /dev/stdin "$pkgdir"/usr/bin/x6525-display-report <<'EOF'
#!/bin/sh
# x6525-display-report: why is the screen black? Run as root (sudo), over SSH.
# Writes /tmp/x6525-display-report.txt and prints it.
out=/tmp/x6525-display-report.txt
{
	echo "== date / kernel / cmdline"
	date; uname -a; cat /proc/cmdline
	echo
	echo "== DRM cards and the panel driver's symlink"
	ls -l /dev/dri/ 2>&1
	for c in /sys/class/drm/card*; do
		[ -e "$c" ] || continue
		echo "$c -> $(readlink -f "$c")"
	done
	for c in /sys/class/drm/card*-*; do
		[ -e "$c" ] || continue
		echo "$c: status=$(cat "$c"/status 2>/dev/null) enabled=$(cat "$c"/enabled 2>/dev/null) modes=$(tr '\n' ' ' < "$c"/modes 2>/dev/null)"
	done
	echo
	echo "== backlight"
	for b in /sys/class/backlight/*; do
		[ -e "$b" ] || continue
		echo "$b: brightness=$(cat "$b"/brightness) max=$(cat "$b"/max_brightness)"
	done
	echo
	echo "== GPU"
	dmesg | grep -iE 'panfrost|mali' | tail -20
	for d in /sys/class/devfreq/*; do
		[ -e "$d" ] || continue
		echo "$d: cur=$(cat "$d"/cur_freq 2>/dev/null) governor=$(cat "$d"/governor 2>/dev/null)"
	done
	echo
	echo "== display stack in dmesg"
	dmesg | grep -iE 'sprd.?drm|dsi|dpu|td4160|panel|simpledrm|drm' | tail -60
	echo
	echo "== session units"
	systemctl --no-pager --lines=0 status greetd plasma-mobile plasmalogin 2>&1 | grep -E '●|Active:|Loaded:'
	echo
	echo "== session drop-ins"
	for f in /etc/systemd/system/greetd.service.d/*.conf /etc/systemd/system/plasma-mobile.service.d/*.conf; do
		[ -e "$f" ] || continue
		echo "--- $f"; cat "$f"
	done
	echo
	echo "== session log (this boot)"
	journalctl -b --no-pager -u greetd -u plasma-mobile -u plasmalogin 2>&1 | tail -80
	echo
	echo "== compositor and shell processes"
	ps -eo pid,user,args | grep -E 'phoc|phosh|greetd|kwin|plasma' | grep -v grep
} > "$out" 2>&1
cat "$out"
echo
echo "saved to $out"
EOF

	# Plasma Mobile: plasma-mobile.service runs /usr/bin/startplasmamobile,
	# which starts KWin Wayland as the session. KWin reads KWIN_DRM_DEVICES (a
	# colon-separated list; with it set, every other card is ignored) and gets
	# the same panel-driver choice as phoc above - the backlight and the
	# 68x152 mm scale only exist on that card. plasmalogin.service, the Plasma
	# login manager some images pull in, starts a KWin-based greeter and gets
	# the same environment. Drop-in directories for units that are not
	# installed are ignored, so these are harmless on a phosh image.
	for unit in plasma-mobile plasmalogin; do
		install -Dm644 /dev/stdin \
			"$pkgdir"/etc/systemd/system/$unit.service.d/10-x6525-drm.conf <<'EOF'
[Service]
Environment=KWIN_DRM_DEVICES=/dev/dri/x6525-primary
EOF
		# Software rendering, as for phosh above: KWin composes with QPainter
		# (KWIN_COMPOSE=Q) instead of GLES through Panfrost, Qt Quick uses its
		# software scene graph, and Mesa clients use llvmpipe. Delete this file
		# to try the GPU again.
		install -Dm644 /dev/stdin \
			"$pkgdir"/etc/systemd/system/$unit.service.d/20-x6525-software-render.conf <<'EOF'
[Service]
Environment=KWIN_COMPOSE=Q
Environment=QT_QUICK_BACKEND=software
Environment=LIBGL_ALWAYS_SOFTWARE=1
EOF
	done

	# Name the sprd-drm card so the session above can point at it without
	# guessing card0/card1. If sprd_drm failed to probe, no symlink appears,
	# phoc cannot start, and the simpledrm console plus SSH remain for
	# recovery - which is the diagnostic.
	install -Dm644 /dev/stdin "$pkgdir"/usr/lib/udev/rules.d/90-x6525-drm-primary.rules <<'EOF'
ACTION=="add", SUBSYSTEM=="drm", DRIVERS=="sprd-drm", KERNEL=="card[0-9]*", SYMLINK+="dri/x6525-primary"
EOF
}

sha512sums="
52f6b1fdf5d4becb2ecd26b63d917696671916348c82215d3a6c005bc2e0ad70993892e2e4b85ff61bef30879a2d1d505e569438a91b22c07ea3ebbb3d61c683  deviceinfo
13b1c3f56f29e9b16034f47550ca39ecaac1828012533f213c2144cd4a44d9c2bc27c6ec81b60ef31f14d42f7c80d109236c831a7c7c01743ce52c4223dcb59a  kernel-cmdline.conf
