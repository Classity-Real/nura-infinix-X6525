#!/bin/sh
# apk commit hook: after every apk transaction check that the boot filesystem still holds
# what U-Boot's extlinux asks for, and keep a copy of the last complete set for reference.
#
# It NEVER restores files. A restore pairs files from different builds (an old vmlinuz with
# new modules or initramfs), and the kernel then refuses the module BTF ("failed to load
# module btf: -22") and the GPU/display modules fail to load. If /boot is incomplete, the
# fix is to reflash one complete build, not to mix files.
# Installed as /etc/apk/commit_hooks.d/90-x6525-boot-check; never fails the transaction.
[ "$1" = post-commit ] || exit 0
B=/boot
BK=/var/lib/x6525-boot-backup
NEED="vmlinuz initramfs ums9230-infinix-x6525.dtb extlinux/extlinux.conf"
mountpoint -q "$B" 2>/dev/null || { echo "x6525-boot-check: $B is not a separate mount, skipping"; exit 0; }
good() { for f in $NEED; do [ -s "$B/$f" ] || return 1; done; }
sync
if good; then
	# the backup is only replaced when the whole set is present, so it is always one build
	rm -rf "$BK.new"; mkdir -p "$BK.new/extlinux" &&
	for f in $NEED; do cp -p "$B/$f" "$BK.new/$f" || { rm -rf "$BK.new"; exit 0; }; done
	uname -r > "$BK.new/kernel-release"
	rm -rf "$BK"; mv "$BK.new" "$BK"; sync
	echo "x6525-boot-check: $B is complete (kernel $(uname -r)); reference copy in $BK"
else
	echo "x6525-boot-check: $B is INCOMPLETE. Do NOT reboot. Not restoring anything (mixing builds"
	echo "x6525-boot-check: breaks the module BTF and the GPU). Reflash one complete rom build instead."
fi
exit 0
