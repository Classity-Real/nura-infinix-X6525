# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="Infinix X6525"
deviceinfo_manufacturer="Infinix"
deviceinfo_codename="infinix-x6525"
deviceinfo_uboot_boardname="infinix-x6525"
deviceinfo_year="2023"
deviceinfo_dtb="sprd/ums9230-infinix-x6525"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_drm="true"
deviceinfo_chassis="handset"

# Display and serial console. The panel is 720x1612; the width and height let
# framebuffer tools (unl0kr, the charging screen) size themselves. The kernel
# console is on uart1 (ttyS1, 115200 8N1, see kernel-cmdline.conf), so offer a
# login there as well: with a UART attached it is a way in that needs neither
# the USB network nor the screen.
deviceinfo_screen_width="720"
deviceinfo_screen_height="1612"
deviceinfo_getty="ttyS1;115200"

# Bootloader related

# The primary bootloader cannot be replaced, so U-Boot is chainloaded from an
# Android boot image, as on the Reeder S19 Max Pro S (Jolla C2). U-Boot's
# extlinux config then supplies kernel, DTB and initramfs from the first
# partition of the exported image, and the initramfs finds the root partition
# by its filesystem UUID (pmos_root_uuid on the kernel command line, put there
# by boot-deploy from the image's own fstab).
deviceinfo_generate_bootimg="true"
deviceinfo_generate_extlinux_config="true"
deviceinfo_bootimg_override_payload="u-boot.bin"
deviceinfo_bootimg_override_initramfs="dummy-initramfs"

# Header version 4 so that the bootloader does not look for a device tree in
# the U-Boot image. The flash offsets are ignored when version 4 is used.
deviceinfo_bootimg_custom_args="--header_version 4"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00000000"
deviceinfo_flash_offset_ramdisk="0x00000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000000"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_method="fastboot"
# USB network function the initramfs and the system expose. NCM rather than the
# default RNDIS: the Galaxy A01 Core used as a host (kernel-a01c, 4.14) has
# cdc_ncm, cdc_ether and cdc_eem built in but USB_NET_RNDIS_HOST off, and Linux
# hosts, macOS and Windows 11 all speak NCM. Windows 10 needs a driver for it:
# set this back to "rndis.usb0" (the default) for a Windows 10 host.
deviceinfo_usb_network_function="ncm.usb0"
# boot_a takes U-Boot: `pmbootstrap flasher flash_kernel`, or `fastboot flash
# boot_a boot.img` with the exported image. The rootfs is NOT flashed into an
# eMMC partition. `install` builds it as a full MBR+GPT disk image whose first
# partition carries /extlinux, /vmlinuz, /initramfs and the DTB, and U-Boot
# cannot see a partition table nested inside a partition - blk-uclass.c's
# part_create_block_devices() returns unless the device is UCLASS_BLK, and a
# partition is UCLASS_PARTITION - so `flasher flash_rootfs`, which would write
# that whole image into `super` (1.36 GB, no length check), leaves the phone at
# the U-Boot prompt. Write the disk image to a microSD card instead, whole, and
# boot from the card; only boot_a is touched on the eMMC. FIRST_BOOT.md has the
# exact steps. The rootfs partition variable stays for the case the rootfs is
# flashed as a filesystem image by hand; the documented procedure never uses it.
deviceinfo_flash_fastboot_partition_kernel="boot_a"
deviceinfo_flash_fastboot_partition_rootfs="super"
