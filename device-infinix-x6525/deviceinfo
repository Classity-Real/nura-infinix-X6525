# DRAFT, untested. Values marked (verified) come from your boot.img / vendor_boot.img.
deviceinfo_format_version="0"
deviceinfo_name="Infinix X6525"
deviceinfo_manufacturer="Infinix"
deviceinfo_codename="infinix-x6525"
deviceinfo_year="2023"
deviceinfo_arch="aarch64"
deviceinfo_chassis="handset"

deviceinfo_screen_width="720"
deviceinfo_screen_height="1612"          # from lcd_size=1612x720 on the stock cmdline (verified)

deviceinfo_external_storage="true"
# userdata logical sector size: check with `blockdev --getss /dev/block/by-name/userdata`.
# pmbootstrap defaults to 512. Only add deviceinfo_rootfs_image_sector_size="4096" if that prints 4096.

# The bootloader appends lcd_*, androidboot.* etc. itself, so only keep what the kernel needs.
deviceinfo_kernel_cmdline="console=ttyS1,115200n8 androidboot.selinux=permissive enforcing=0 cgroup_disable=pressure,net_prio cgroup_no_v1=cpu,cpuset,blkio,io,memory"

# Boot image: header v4 + separate vendor_boot (verified)
deviceinfo_header_version="4"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x0"
deviceinfo_flash_offset_kernel="0x8000"
deviceinfo_flash_offset_ramdisk="0x5400000"
deviceinfo_flash_offset_tags="0x100"
deviceinfo_flash_offset_dtb="0x1f00000"
deviceinfo_generate_bootimg="true"

deviceinfo_flash_method="fastboot"
deviceinfo_flash_sparse="true"   # Unisoc fastboot usually wants sparse images (unverified)
# Kernel 5.4 has RD_GZIP and RD_LZ4 but no zstd initramfs support.
deviceinfo_initfs_compression="gzip"
deviceinfo_usb_network_function="rndis.usb0"   # Unisoc vendor RNDIS gadget (sprd_f_rndis), built in via pmos.config
# Display, eMMC and USB drivers are modules in the stock config; pmos.config builds them in.
# NOTE (corrected): header_version=4 does not drop the DTB. boot-deploy generates vendor_boot.img for
# v3/v4 and embeds the DTB from deviceinfo_dtb (the kernel package's dtbs) via mkbootimg, so the stock
# DTB is replaced by ours rather than lost. flash_offset_* are ignored at v4. See README.
deviceinfo_modules_initfs=""
