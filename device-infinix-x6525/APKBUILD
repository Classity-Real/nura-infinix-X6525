arch="aarch64"
options="!check !archcheck"
depends="postmarketos-base linux-infinix-x6525"
makedepends="devicepkg-dev"
source="deviceinfo
	infinix,x6525.conf"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/infinix,x6525.conf "$pkgdir"/etc/megapixels/config/infinix,x6525.conf
	install -Dm644 "$srcdir"/infinix,x6525.conf "$pkgdir"/usr/share/megapixels/config/infinix,x6525.conf
}

