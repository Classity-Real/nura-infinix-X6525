+/*
+ * Many raw sensor drivers do not implement VIDIOC_SUBDEV_S_FRAME_INTERVAL and
+ * instead expose the frame timing through V4L2_CID_VBLANK. If the sensor has
+ * PIXEL_RATE, HBLANK and VBLANK controls, program VBLANK so the sensor runs at
+ * the Rate configured for this mode. This also sets the maximum exposure time,
+ * which is bounded by the frame length.
+ */
+static void
+set_sensor_rate(libmegapixels_camera *camera, libmegapixels_mode *mode)
+{
+	if (camera->sensor_fd <= 0 || mode->rate <= 0)
+		return;
+
+	struct v4l2_ext_control ectrl = {.id = V4L2_CID_PIXEL_RATE};
+	struct v4l2_ext_controls ectrls = {.which = V4L2_CTRL_WHICH_CUR_VAL, .count = 1, .controls = &ectrl};
+	if (xioctl(camera->sensor_fd, VIDIOC_G_EXT_CTRLS, &ectrls) == -1)
+		return;
+	long long pixel_rate = ectrl.value64;
+
+	struct v4l2_control hblank = {.id = V4L2_CID_HBLANK};
+	if (xioctl(camera->sensor_fd, VIDIOC_G_CTRL, &hblank) == -1)
+		return;
+
+	struct v4l2_queryctrl qvblank = {.id = V4L2_CID_VBLANK};
+	if (xioctl(camera->sensor_fd, VIDIOC_QUERYCTRL, &qvblank) == -1)
+		return;
+	if (qvblank.flags & (V4L2_CTRL_FLAG_READ_ONLY | V4L2_CTRL_FLAG_DISABLED))
+		return;
+
+	long long line_length = (long long) mode->width + hblank.value;
+	if (pixel_rate <= 0 || line_length <= 0)
+		return;
+
+	long long frame_length = pixel_rate / (line_length * mode->rate);
+	long long vblank = frame_length - mode->height;
+	if (vblank < qvblank.minimum)
+		vblank = qvblank.minimum;
+	if (vblank > qvblank.maximum)
+		vblank = qvblank.maximum;
+
+	struct v4l2_control vb = {.id = V4L2_CID_VBLANK, .value = (int) vblank};
+	if (xioctl(camera->sensor_fd, VIDIOC_S_CTRL, &vb) == -1) {
+		log_error("Could not set vblank to %lld: %s\n", vblank, strerror(errno));
+		return;
+	}
+	log_debug("  Rate %d fps via vblank %lld (pixel rate %lld, line length %lld)\n", mode->rate, vblank,
+		pixel_rate, line_length);
+}
