From bb0dd23ad5ac3eb304e25ab7c9347102d3ccc851 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Wed, 14 Oct 2026 11:22:35 +0000
Subject: [PATCH 1/2] add device tree for Infinix X6525

The Infinix X6525 is a Unisoc UMS9230 phone, sold as the "Smart 8", based on
the 1H10-GO reference design. Model it on the Reeder S19 Max Pro S with this
board's values:

- the internal storage is an eMMC on sdio3 (the stock bootloader passes
  androidboot.boot_devices=.../201d0000.sdio and sprdboot.flash=emmc), so it is
  the boot device; the microSD slot stays enabled as a rescue boot path
- the framebuffer is the one the previous boot stage set up, at
  lcd_base=9e000000 with lcd_size=1612x720 at 24bpp
- battery scalars taken from the board device tree

The memory node is the 4 GiB window the stock kernel is handed
(androidboot.ddrsize=4096M); the Reeder's 8 GiB value would put U-Boot's
relocation above the end of DRAM. The battery node carries the OCV and
resistance tables read from the running device.

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 arch/arm/dts/ums9230-infinix-x6525.dts | 100 +++++++++++++++++++++++++
 1 file changed, 100 insertions(+)
 create mode 100644 arch/arm/dts/ums9230-infinix-x6525.dts

diff --git a/arch/arm/dts/ums9230-infinix-x6525.dts b/arch/arm/dts/ums9230-infinix-x6525.dts
new file mode 100644
index 0000000..7165dde
--- /dev/null
+++ b/arch/arm/dts/ums9230-infinix-x6525.dts
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Infinix X6525 ("Smart 8") - Unisoc UMS9230
+ *
+ * Modelled on ums9230-reeder-s19mps.dts, with the values taken from this
+ * device's stock bootloader parameters (lcd_base, lcd_size, logo_bpix,
+ * sprdboot.flash, androidboot.boot_devices).
+ */
+
+/dts-v1/;
+
+#include "ums9230.dtsi"
+#include "sc2730.dtsi"
+
+/ {
+	model = "Infinix X6525";
+
+	compatible = "infinix,x6525", "sprd,ums9230";
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+		/* eMMC is the boot device (androidboot.boot_devices=
+		 * .../201d0000.sdio, sprdboot.flash=emmc) */
+		mmc0 = &sdio3;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0xfffff000>;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		stdout-path = "serial1:115200n8";
+
+		/* The stock bootloader passes lcd_base=9e000000,
+		 * lcd_size=1612x720 and logo_bpix=24, and leaves the panel
+		 * running, so U-Boot can just draw into that framebuffer. */
+		framebuffer@9e000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x9e000000 0x0 (720 * 1612 * 4)>;
+			width = <720>;
+			height = <1612>;
+			stride = <(720 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	bat: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <4950000>;
+		charge-term-current-microamp = <200000>;
+		constant-charge-voltage-max-microvolt = <4400000>;
+		voltage-min-design-microvolt = <3450000>;
+		factory-internal-resistance-micro-ohms = <140000>;
+		fast-charge-threshold-microvolt = <4100000>;
+		resistance-temp-table = <50 80>, <25 100>, <10 168>,
+					<0 421>, <(-10) 688>;
+		ocv-capacity-celsius = <20>;
+		ocv-capacity-table-0 = <4380000 100>, <4312000 95>,
+				       <4248000 90>, <4191000 85>,
+				       <4135000 80>, <4081000 75>,
+				       <4029000 70>, <3977000 65>,
+				       <3937000 60>, <3875000 55>,
+				       <3839000 50>, <3813000 45>,
+				       <3795000 40>, <3780000 35>,
+				       <3772000 30>, <3762000 25>,
+				       <3746000 20>, <3722000 15>,
+				       <3683000 10>, <3623000 5>,
+				       <3400000 0>;
+	};
+};
+
+/* SD card slot, kept as a rescue boot path */
+&sdio0 {
+	status = "okay";
+};
+
+/* eMMC - the boot device */
+&sdio3 {
+	bus-width = <8>;
+	non-removable;
+	status = "okay";
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&usb {
+	status = "okay";
+};
-- 
