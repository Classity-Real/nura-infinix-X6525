diff --git a/src/libdng.c b/src/libdng.c
index f989150..89dca08 100644
--- a/src/libdng.c
+++ b/src/libdng.c
@@ -414,6 +414,10 @@ libdng_write_with_thumbnail(libdng_info *dng, const char *path, unsigned int wid
 
 	uint8_t *raw_frame = (uint8_t *) data;
 	if (dng->needs_repack) {
+		size_t min_len = (((size_t) width * dng->bit_depth + 7) / 8) * height;
