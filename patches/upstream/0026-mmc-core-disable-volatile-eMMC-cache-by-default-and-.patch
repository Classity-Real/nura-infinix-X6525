From b57e84a2ebb2a4dd53830a410f2206d4e6d7a903 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sun, 25 Oct 2026 09:23:13 +0000
Subject: [PATCH] mmc: core: disable volatile eMMC cache by default and flush
 on shutdown

On the Infinix X6525 (Foresee C09F00 eMMC, CACHE_SIZE=1536 KiB,
WR_REL_PARAM=0x15), unconditionally enabling EXT_CSD_CACHE_CTRL in
mmc_init_card() leaves the volatile SRAM cache active throughout
initramfs (where e2fsck replays the journal and updates inode tables)
and early boot before userspace services run, and re-enables it on
every resume/reset. Because ext4 journal commit blocks use REQ_FUA
(CMD23 Reliable Write, bypassing the volatile cache), a reboot or
power cut before non-FUA inode table writes are flushed leaves torn
4 KiB inode table blocks ('Inode N seems to contain garbage').

Keep EXT_CSD_CACHE_CTRL disabled by default (opt-in via
mmc_core.enable_cache=1), flushing any dirty cache lines before
turning it off in mmc_init_card() and unconditionally issuing
EXT_CSD_FLUSH_CACHE on shutdown.

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 drivers/mmc/core/mmc.c | 52 ++++++++++++++++++++++++++++++++----------
 1 file changed, 40 insertions(+), 12 deletions(-)

diff --git a/drivers/mmc/core/mmc.c b/drivers/mmc/core/mmc.c
index 05444ec..f44b10f 100644
--- a/drivers/mmc/core/mmc.c
+++ b/drivers/mmc/core/mmc.c
@@ -8,6 +8,7 @@
  */
 
 #include <linux/err.h>
+#include <linux/moduleparam.h>
 #include <linux/of.h>
 #include <linux/slab.h>
 #include <linux/stat.h>
@@ -33,6 +34,11 @@
 #define MIN_CACHE_EN_TIMEOUT_MS 1600
 #define CACHE_FLUSH_TIMEOUT_MS 30000 /* 30s */
 
+static bool enable_cache;
+module_param(enable_cache, bool, 0444);
+MODULE_PARM_DESC(enable_cache,
+		 "Enable volatile eMMC write-back cache (default: off)");
+
 enum mmc_poweroff_type {
 	MMC_POWEROFF_SUSPEND,
 	MMC_POWEROFF_SHUTDOWN,
@@ -1894,20 +1900,35 @@ static int mmc_init_card(struct mmc_host *host, u32 ocr,
 		unsigned int timeout_ms = MIN_CACHE_EN_TIMEOUT_MS;
 
 		timeout_ms = max(card->ext_csd.generic_cmd6_time, timeout_ms);
-		err = mmc_switch(card, EXT_CSD_CMD_SET_NORMAL,
-				EXT_CSD_CACHE_CTRL, 1, timeout_ms);
-		if (err && err != -EBADMSG)
-			goto free_card;
+		if (enable_cache) {
+			err = mmc_switch(card, EXT_CSD_CMD_SET_NORMAL,
+					EXT_CSD_CACHE_CTRL, 1, timeout_ms);
+			if (err && err != -EBADMSG)
+				goto free_card;
 
-		/*
-		 * Only if no error, cache is turned on successfully.
-		 */
-		if (err) {
-			pr_warn("%s: Cache is supported, but failed to turn on (%d)\n",
-				mmc_hostname(card->host), err);
-			card->ext_csd.cache_ctrl = 0;
+			/*
+			 * Only if no error, cache is turned on successfully.
+			 */
+			if (err) {
+				pr_warn("%s: Cache is supported, but failed to turn on (%d)\n",
+					mmc_hostname(card->host), err);
+				card->ext_csd.cache_ctrl = 0;
+			} else {
+				card->ext_csd.cache_ctrl = 1;
+			}
 		} else {
-			card->ext_csd.cache_ctrl = 1;
+			/*
+			 * Flush and disable the volatile eMMC cache by default
+			 * so that writes during initramfs fsck/mount, runtime,
+			 * and after resume/reset go straight to NAND and cannot
+			 * leave torn ext4 inode table blocks across reboots.
+			 */
+			mmc_switch(card, EXT_CSD_CMD_SET_NORMAL,
+				   EXT_CSD_FLUSH_CACHE, 1,
+				   CACHE_FLUSH_TIMEOUT_MS);
+			mmc_switch(card, EXT_CSD_CMD_SET_NORMAL,
+				   EXT_CSD_CACHE_CTRL, 0, timeout_ms);
+			card->ext_csd.cache_ctrl = 0;
 		}
 	}
 
@@ -2152,6 +2173,13 @@ static int _mmc_suspend(struct mmc_host *host, enum mmc_poweroff_type pm_type)
 	 * Avoid cache flush and notify the device to power off quickly.
 	 */
 	if (pm_type != MMC_POWEROFF_UNDERVOLTAGE) {
+		if (pm_type == MMC_POWEROFF_SHUTDOWN &&
+		    host->card->ext_csd.cache_size > 0 &&
+		    !_mmc_cache_enabled(host)) {
+			mmc_switch(host->card, EXT_CSD_CMD_SET_NORMAL,
+				   EXT_CSD_FLUSH_CACHE, 1,
+				   CACHE_FLUSH_TIMEOUT_MS);
+		}
 		err = _mmc_flush_cache(host);
 		if (err)
 			goto out;
-- 
2.47.3

