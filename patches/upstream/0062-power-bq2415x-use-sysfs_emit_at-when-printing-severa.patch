From baed9494a0e87d953ab5f0df9848a9c208315c10 Mon Sep 17 00:00:00 2001
From: ci <a@b>
Date: Sun, 1 Nov 2026 18:32:20 +0800
Subject: [PATCH 2/2] power: bq2415x: use sysfs_emit_at() when printing several
 registers

bq2415x_sysfs_show_registers() passed buf + offset to sysfs_emit(), which
warns because the buffer is no longer page aligned on every read of the
registers attribute.
---
 drivers/power/supply/bq2415x_charger.c | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/drivers/power/supply/bq2415x_charger.c b/drivers/power/supply/bq2415x_charger.c
index 5d47de3ff..8af7b4bdc 100644
--- a/drivers/power/supply/bq2415x_charger.c
+++ b/drivers/power/supply/bq2415x_charger.c
@@ -1295,13 +1295,13 @@ static ssize_t bq2415x_sysfs_set_registers(struct device *dev,
 /* print value of chip register, format: 'register=value' */
 static ssize_t bq2415x_sysfs_print_reg(struct bq2415x_device *bq,
 				       u8 reg,
-				       char *buf)
+				       char *buf, int at)
 {
 	int ret = bq2415x_i2c_read(bq, reg);
 
 	if (ret < 0)
-		return sysfs_emit(buf, "%#.2x=error %d\n", reg, ret);
-	return sysfs_emit(buf, "%#.2x=%#.2x\n", reg, ret);
+		return sysfs_emit_at(buf, at, "%#.2x=error %d\n", reg, ret);
+	return sysfs_emit_at(buf, at, "%#.2x=%#.2x\n", reg, ret);
 }
 
 /* show all raw values of chip register, format per line: 'register=value' */
@@ -1313,11 +1313,11 @@ static ssize_t bq2415x_sysfs_show_registers(struct device *dev,
 	struct bq2415x_device *bq = power_supply_get_drvdata(psy);
 	ssize_t ret = 0;
 
-	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_STATUS, buf+ret);
-	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_CONTROL, buf+ret);
-	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_VOLTAGE, buf+ret);
-	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_VENDER, buf+ret);
-	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_CURRENT, buf+ret);
+	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_STATUS, buf, ret);
+	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_CONTROL, buf, ret);
+	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_VOLTAGE, buf, ret);
+	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_VENDER, buf, ret);
+	ret += bq2415x_sysfs_print_reg(bq, BQ2415X_REG_CURRENT, buf, ret);
 	return ret;
 }
 
