From 5d13a7e9c2b84f0a9e6d3c1b7a2f4e8d9c0b1a2f Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sat, 24 Oct 2026 08:33:00 +0000
Subject: [PATCH] Bluetooth: btsprdsipc: fall back to a random BD address

The ums9230 dtsi leaves local-bd-address for the bootloader to fill in.
U-Boot's ft_board_setup() does fill it in, from the "bdaddr" environment
variable - but this board's default environment has no bdaddr (the common
ums9230 env reads it from a UFS prodnv partition, which this eMMC board
does not have), and string_to_enetaddr(NULL) zero-fills, so the property
ends up all-zero after all.

The HCI core rejects an all-zero (or missing) property:
hci_dev_get_bd_addr_from_property() returns without setting public_addr,
and because public_addr stays BDADDR_ANY, hci_dev_setup_sync() skips
set_bdaddr() altogether. In this driver set_bdaddr() is not just the
address setter: it is where the pskey and RF configuration blobs are sent
(HCI 0xfca0/0xfca2) and the controller is enabled, so the transport
probes, registers an HCI device and then never initialises the chip.

Fall back to a random, locally administered address. It is not stable
across boots - and with it the pairings - until the bootloader reads a
real address (for example from a btmac file in the device's prodnv
partition, as the common env does over UFS) or the device tree supplies
one, but Bluetooth works in the meantime.
Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 1 file changed, 25 insertions

diff --git a/drivers/bluetooth/btsprdsipc.c b/drivers/bluetooth/btsprdsipc.c
--- a/drivers/bluetooth/btsprdsipc.c
+++ b/drivers/bluetooth/btsprdsipc.c
@@ -8,6 +8,8 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/random.h>
 #include <linux/rpmsg.h>
 
 #include <net/bluetooth/bluetooth.h>
@@ -146,6 +148,7 @@
 	const struct firmware *fw;
 	struct btsprdsipc *bts;
 	struct hci_dev *hdev;
+	bdaddr_t addr;
 	int ret;
 
 	bts = devm_kzalloc(&rpdev->dev, sizeof(*bts), GFP_KERNEL);
@@ -185,6 +188,28 @@
 	bts->hu.hdev = hdev;
 	bts->ept = rpdev->ept;
 	SET_HCIDEV_DEV(hdev, &rpdev->dev);
+
+	/*
+	 * The dtsi leaves local-bd-address for the bootloader to fill in.
+	 * U-Boot's ft_board_setup() writes it from its "bdaddr" environment
+	 * variable, which is unset on this board, and string_to_enetaddr(NULL)
+	 * zero-fills - so the property ends up all-zero. The HCI core rejects
+	 * an all-zero (or missing) property, leaves public_addr zero and
+	 * therefore never calls set_bdaddr(), which is where this driver
+	 * sends the pskey and RF configuration - so the controller would
+	 * never be initialised. Fall back to a random, locally administered
+	 * address. It is not stable across boots (nor are the pairings)
+	 * until the bootloader or the dtsi supplies a real one.
+	 */
+	if (device_property_read_u8_array(&rpdev->dev, "local-bd-address",
+					  (u8 *)&addr, sizeof(addr)) ||
+	    !bacmp(&addr, BDADDR_ANY)) {
+		get_random_bytes(&addr, sizeof(addr));
+		((u8 *)&addr)[0] = (((u8 *)&addr)[0] & 0xfc) | 0x02;
+		dev_warn(&rpdev->dev, "no local-bd-address, using %pM\n",
+			 &addr);
+	}
+	bacpy(&hdev->public_addr, &addr);
 
 	hdev->manufacturer = 1855;
 	hdev->bus = HCI_SMD;
