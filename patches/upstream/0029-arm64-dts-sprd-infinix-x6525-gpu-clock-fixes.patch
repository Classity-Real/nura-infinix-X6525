From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Tue, 27 Oct 2026 10:12:00 +0000
Subject: [PATCH] arm64: dts: sprd: fix the X6525's GPU memory clock and OPP table

Park gpu-mem-clk on twpll_512m: nothing else sets it and it stays on its 26 MHz reset parent. Drop the 768 MHz OPP: the stock driver disables 768 and 850 MHz on T606 (GPLL is capped at 650 MHz).
---
diff --git a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
index 2e0b5cf..f1ac2ee 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
@@ -800,11 +800,11 @@ &cpufreq {
 /*
  * GPU DVFS. The frequencies and voltages are the stock kernel's own table for
  * this GPU (operating-points in its gpu@23100000 node): 384 MHz @ 0.70 V,
- * 512 MHz and 614.4 MHz @ 0.75 V, 768 MHz @ 0.80 V. The stock table also has
- * 850 MHz @ 0.80 V, which the mainline GPU clock has no fixed parent for - it
- * would need the GPU PLL to be programmed - so it is left out until that path
- * is tested. Without an OPP table Panfrost runs at whatever rate the
- * bootloader left and never scales.
+ * 512 MHz and 614.4 MHz @ 0.75 V. The stock table also has 768 MHz and
+ * 850 MHz, but the stock driver disables both on T606 (the part is capped at
+ * GPLL = 650 MHz), so they are left out; 650 MHz @ 0.80 V needs GPLL to be
+ * programmed and is left out until that path is tested. Without an OPP table
+ * Panfrost runs at whatever rate the bootloader left and never scales.
  */
 / {
 	gpu_opp_table: opp-table {
@@ -824,11 +824,6 @@ opp-614400000 {
 			opp-hz = /bits/ 64 <614400000>;
 			opp-microvolt = <750000>;
 		};
-
-		opp-768000000 {
-			opp-hz = /bits/ 64 <768000000>;
-			opp-microvolt = <800000>;
-		};
 	};
 };
 
@@ -836,6 +831,9 @@ &gpu {
 	mali-supply = <&vddgpu>;
 	operating-points-v2 = <&gpu_opp_table>;
 	#cooling-cells = <2>;
+	/* the memory clock otherwise stays on its 26 MHz reset parent */
+	assigned-clocks = <&gpu_clk CLK_GPU_MEM>;
+	assigned-clock-parents = <&pll1 CLK_TWPLL_512M>;
 	status = "okay";
 };
 
