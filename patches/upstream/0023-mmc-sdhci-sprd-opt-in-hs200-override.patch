From 8ea468c7b5b703e4a369865a06c4ab4c98b50025 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sat, 24 Oct 2026 13:31:07 +0000
Subject: [PATCH] mmc: sdhci-sprd: add an opt-in override for the HS200 quirk

sdhci_sprd_pdata sets SDHCI_QUIRK2_BROKEN_HS200 for every r11
controller. The core turns that into "no MMC_CAP2_HS200", and HS400 is
gated behind HS200, so the X6525's eMMC is limited to DDR52 even though
its stock kernel runs the same part at HS400.

The quirk presumably protects older r11 SoCs, so do not clear it by
default here: the eMMC is the root filesystem, and a failed HS200/HS400
tune at boot is not recoverable from the same device. Add a
boot-time-only parameter instead - sdhci_sprd.enable_hs200=1 - so the
link can be tested on hardware before the quirk is narrowed.

This is a bring-up knob for the X6525 port, not a submission-ready
change.

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 drivers/mmc/host/sdhci-sprd.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/mmc/host/sdhci-sprd.c b/drivers/mmc/host/sdhci-sprd.c
index 3892851c6..e2d43fd5b 100644
--- a/drivers/mmc/host/sdhci-sprd.c
+++ b/drivers/mmc/host/sdhci-sprd.c
@@ -750,6 +750,19 @@ static const struct sdhci_pltfm_data sdhci_sprd_pdata = {
 	.ops = &sdhci_sprd_ops,
 };
 
+/*
+ * The driver marks HS200 broken for every r11 controller, which also clears
+ * MMC_CAP2_HS200 in the core (and HS400 is gated behind HS200). The UMS9230's
+ * stock kernel runs this eMMC at HS400, so the quirk is too broad for at
+ * least this SoC - but clearing it by default would change the root
+ * filesystem's link at boot, before anything can be tested. Opt in with
+ * sdhci_sprd.enable_hs200=1 on the kernel command line and watch the boot.
+ */
+static bool enable_hs200;
+module_param(enable_hs200, bool, 0444);
+MODULE_PARM_DESC(enable_hs200,
+		 "Clear SDHCI_QUIRK2_BROKEN_HS200 (default: off)");
+
 static int sdhci_sprd_probe(struct platform_device *pdev)
 {
 	struct sdhci_host *host;
@@ -762,6 +775,9 @@ static int sdhci_sprd_probe(struct platform_device *pdev)
 	if (IS_ERR(host))
 		return PTR_ERR(host);
 
+	if (enable_hs200)
+		host->quirks2 &= ~SDHCI_QUIRK2_BROKEN_HS200;
+
 	host->dma_mask = DMA_BIT_MASK(64);
 	pdev->dev.dma_mask = &host->dma_mask;
 	host->mmc_host_ops.request = sdhci_sprd_request;
-- 
