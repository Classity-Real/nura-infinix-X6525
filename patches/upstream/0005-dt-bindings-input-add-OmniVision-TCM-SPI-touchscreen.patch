From bd51bbc2bbb6479817d6a3124f5642838123fc1c Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Tue, 13 Oct 2026 21:46:16 +0000
Subject: [PATCH 1/2] dt-bindings: input: add OmniVision TCM SPI touchscreen

Add the binding for OmniVision TCM touch controllers connected over SPI with
host firmware download, as used for the TD4160 panel in the Infinix X6525.

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 .../input/touchscreen/omnivision,tcm-spi.yaml | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/omnivision,tcm-spi.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/omnivision,tcm-spi.yaml b/Documentation/devicetree/bindings/input/touchscreen/omnivision,tcm-spi.yaml
new file mode 100644
index 0000000..45b76d5
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/omnivision,tcm-spi.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/omnivision,tcm-spi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision TCM touchscreen controller (SPI, host firmware download)
+
+maintainers:
+  - Seuj09 <jeus110310@gmail.com>
+
+description:
+  Touch controller of the TD4160 touch/display IC. It has no flash: after each
+  reset the host downloads the application firmware and its configuration from
+  an image file.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: omnivision,tcm-spi
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      Reset line. The controller is held in reset while it is asserted: the
+      vendor device tree drives it low for 20 ms and then releases it, so the
+      line is active-low.
+
+  firmware-name:
+    description: HDL image requested through request_firmware().
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+  - firmware-name
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        touchscreen@0 {
+            compatible = "omnivision,tcm-spi";
+            reg = <0>;
+            spi-max-frequency = <8000000>;
+            spi-cpha;
+            spi-cpol;
+            interrupts-extended = <&gpio 16 IRQ_TYPE_LEVEL_LOW>;
+            reset-gpios = <&gpio 145 GPIO_ACTIVE_LOW>;
+            firmware-name = "hdl_firmware_1.img";
+        };
+    };
+...
-- 
