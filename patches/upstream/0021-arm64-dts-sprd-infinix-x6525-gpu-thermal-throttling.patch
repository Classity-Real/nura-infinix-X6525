From 2747e87ef50404bc84321f501aa75f4f2b3f3623 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sat, 24 Oct 2026 13:30:45 +0000
Subject: [PATCH] arm64: dts: sprd: throttle the X6525's GPU at the SoC's
 thermal point

The mainline gpu-thermal zone has a sensor but no trip and no cooling
device, so the GPU never throttles: the CPUs absorb the package's heat
and the GPU keeps its OPP. Add a 70 C passive trip - the same point the
SoC's CPU zones use - and a devfreq cooling map to the GPU, whose node
gains #cooling-cells.

Panfrost already registers a devfreq cooling device; this is only the
device-tree wiring. The GPU OPP table stops at 768 MHz, so the cooling
states are the existing four OPPs.

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 .../boot/dts/sprd/ums9230-infinix-x6525.dts   | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
index 69e0a41be..d0aa9e521 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
@@ -830,9 +830,33 @@ opp-768000000 {
 &gpu {
 	mali-supply = <&vddgpu>;
 	operating-points-v2 = <&gpu_opp_table>;
+	#cooling-cells = <2>;
 	status = "okay";
 };
 
+/*
+ * The SoC's own gpu-thermal zone has a sensor (ap_thm2 0) but no trip and no
+ * cooling device, so it only reports. Give it the same 70 C passive point the
+ * CPU zones use and let Panfrost's devfreq cooling scale the GPU; without
+ * this, the GPU stays at its OPP while the CPUs throttle the whole package.
+ */
+&{/thermal-zones/gpu-thermal} {
+	trips {
+		gpu_alert0: trip-point0 {
+			temperature = <70000>;
+			hysteresis = <1000>;
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map0 {
+			trip = <&gpu_alert0>;
+			cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+		};
+	};
+};
+
 &modem {
 	status = "okay";
 };
