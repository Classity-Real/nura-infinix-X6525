From a5553f6692dcf977b19f55f4680767ea9c103a9a Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sun, 25 Oct 2026 08:03:31 +0000
Subject: [PATCH] drm/panel: td4160-hx: fix post-command delays and power gpios

In vendor sprd_panel_send_cmds(), the wait byte in the 4-byte packet header is executed after mipi_dsi_dcs_write_buffer(), not before. Fix the sleep-out (0x11 -> 120 ms, 0x29 -> 20 ms) and sleep-in (0x28 -> 20 ms, 0x10 -> 120 ms) sequences so the TD4160 internal DC-DC booster finishes starting up before Display On (0x29) is sent. Also set MIPI_DSI_MODE_LPM, add the stock board DT's AVDD (ap_gpio 54) and AVEE (ap_gpio 55) power GPIOs, and assign the DPU core/DPI parent clocks on the X6525.

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 .../panel/infinix,td4160-hx-panel.yaml        |  8 ++++
 .../boot/dts/sprd/ums9230-infinix-x6525.dts   |  5 ++
 drivers/gpu/drm/panel/panel-td4160-hx.c       | 47 ++++++++++++++++---
 3 files changed, 54 insertions(+), 6 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/panel/infinix,td4160-hx-panel.yaml b/Documentation/devicetree/bindings/display/panel/infinix,td4160-hx-panel.yaml
index f5b1059..0b7788f 100644
--- a/Documentation/devicetree/bindings/display/panel/infinix,td4160-hx-panel.yaml
+++ b/Documentation/devicetree/bindings/display/panel/infinix,td4160-hx-panel.yaml
@@ -34,6 +34,14 @@ properties:
       Panel reset. The vendor device tree drives it active-high; this is the
       first thing to check if the panel stays dark.
 
+  avdd-gpios:
+    maxItems: 1
+    description: Positive analog supply enable (AVDD)
+
+  avee-gpios:
+    maxItems: 1
+    description: Negative analog supply enable (AVEE)
+
 required:
   - compatible
   - reg
diff --git a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
index d0aa9e5..2e0b5cf 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
@@ -694,6 +694,9 @@ &disp {
 };
 
 &dpu {
+	assigned-clocks = <&ap_clk CLK_DISPC0>, <&ap_clk CLK_DISPC0_DPI>;
+	assigned-clock-parents = <&pll1 CLK_TWPLL_384M>, <&pll1 CLK_TWPLL_153M6>;
+	assigned-clock-rates = <384000000>, <153600000>;
 	memory-region = <&framebuffer_region>;
 	status = "okay";
 };
@@ -713,6 +716,8 @@ panel@0 {
 		/* board DT: ap_gpio 0x32 with flag 0 = active-high.
 		 * Flip this first if the panel stays dark. */
 		reset-gpios = <&ap_gpio 50 GPIO_ACTIVE_HIGH>;
+		avdd-gpios = <&ap_gpio 54 GPIO_ACTIVE_HIGH>;
+		avee-gpios = <&ap_gpio 55 GPIO_ACTIVE_HIGH>;
 
 		port {
 			panel_in: endpoint {
diff --git a/drivers/gpu/drm/panel/panel-td4160-hx.c b/drivers/gpu/drm/panel/panel-td4160-hx.c
index 51db712..f7e1fe8 100644
--- a/drivers/gpu/drm/panel/panel-td4160-hx.c
+++ b/drivers/gpu/drm/panel/panel-td4160-hx.c
@@ -57,6 +57,8 @@ struct td4160_panel {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi;
 	struct gpio_desc *reset;
+	struct gpio_desc *avdd;
+	struct gpio_desc *avee;
 	struct backlight_device *backlight;
 	/* The DSI host's clock only runs between pre_enable and post_disable, so
 	 * a DCS write outside that window (a brightness write from user space
@@ -149,23 +151,23 @@ static int td4160_panel_on(struct td4160_panel *ctx)
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x51, 0x00, 0x00);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x53, 0x24);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x03);
-	mipi_dsi_msleep(&dsi_ctx, 120);	/* vendor delay */
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x11);	/* opcode 0x13, delay 120ms */
-	mipi_dsi_msleep(&dsi_ctx, 20);	/* vendor delay */
+	mipi_dsi_msleep(&dsi_ctx, 120);	/* vendor delay */
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x29);	/* opcode 0x13, delay 20ms */
+	mipi_dsi_msleep(&dsi_ctx, 20);	/* vendor delay */
 
 	return dsi_ctx.accum_err;
 }
 
-/* sprd,sleep-in-command = [13 14 00 01 28 13 78 00 01 10]: delay, then command */
+/* sprd,sleep-in-command = [13 14 00 01 28 13 78 00 01 10]: command, then delay */
 static int td4160_panel_off(struct td4160_panel *ctx)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
-	mipi_dsi_msleep(&dsi_ctx, 20);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x28);
-	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_msleep(&dsi_ctx, 20);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x10);
+	mipi_dsi_msleep(&dsi_ctx, 120);
 
 	return dsi_ctx.accum_err;
 }
@@ -175,12 +177,25 @@ static int td4160_panel_prepare(struct drm_panel *panel)
 	struct td4160_panel *ctx = to_td4160_panel(panel);
 	int ret;
 
+	if (ctx->avdd) {
+		gpiod_set_value_cansleep(ctx->avdd, 1);
+		msleep(5);
+	}
+	if (ctx->avee) {
+		gpiod_set_value_cansleep(ctx->avee, 1);
+		msleep(5);
+	}
+
 	td4160_panel_reset(ctx);
 
 	ret = td4160_panel_on(ctx);
 	if (ret < 0) {
 		dev_err(&ctx->dsi->dev, "Failed to initialize panel: %d\n", ret);
 		gpiod_set_value_cansleep(ctx->reset, 0);
+		if (ctx->avee)
+			gpiod_set_value_cansleep(ctx->avee, 0);
+		if (ctx->avdd)
+			gpiod_set_value_cansleep(ctx->avdd, 0);
 		return ret;
 	}
 
@@ -211,6 +226,15 @@ static int td4160_panel_unprepare(struct drm_panel *panel)
 	gpiod_set_value_cansleep(ctx->reset, 0);
 	msleep(5);
 
+	if (ctx->avee) {
+		gpiod_set_value_cansleep(ctx->avee, 0);
+		msleep(5);
+	}
+	if (ctx->avdd) {
+		gpiod_set_value_cansleep(ctx->avdd, 0);
+		msleep(5);
+	}
+
 	return 0;
 }
 
@@ -313,6 +337,16 @@ static int td4160_panel_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->reset),
 				     "Failed to get reset GPIO\n");
 
+	ctx->avdd = devm_gpiod_get_optional(&dsi->dev, "avdd", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->avdd))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->avdd),
+				     "Failed to get avdd GPIO\n");
+
+	ctx->avee = devm_gpiod_get_optional(&dsi->dev, "avee", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->avee))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->avee),
+				     "Failed to get avee GPIO\n");
+
 	ret = devm_mutex_init(&dsi->dev, &ctx->bl_lock);
 	if (ret)
 		return ret;
@@ -330,7 +364,8 @@ static int td4160_panel_probe(struct mipi_dsi_device *dsi)
 	ctx->panel.prepare_prev_first = true;
 	drm_panel_add(&ctx->panel);
 
-	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM;
 	dsi->format = MIPI_DSI_FMT_RGB888;
 	dsi->lanes = 4;
 	/* from the board DT: sprd,phy-bit-clock = 0xf6180 kbps,
-- 
2.47.3

