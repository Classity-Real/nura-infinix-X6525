From a1b2c3d4e5f60718293a4b5c6d7e8f9012345678 Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Tue, 27 Oct 2026 19:40:00 +0000
Subject: [PATCH] rpmsg: sprd_sipc_sbuf: publish sdev before device registration and simplify create_ept

In sipc_sbuf_open(), rpmsg_register_device() registers the child rpmsg
device on the rpmsg bus, which synchronously invokes any already-registered
driver's probe() method (such as btsprdsipc).

During probe, the rpmsg driver core calls rpmsg_create_ept(), which calls
sipc_sbuf_create_ept(). Previously, __sipc_sbuf_create_ept() looped over
sbuf->buffers looking for a matching registered sdev pointer. However,
sipc_sbuf_open() only published sbuf->buffers[rx_id].sdev AFTER
rpmsg_register_device() returned. As a result, when btsprdsipc was loaded
before or concurrently with sprd_wcn initialization, __sipc_sbuf_create_ept()
failed to find the channel and logged:
  channel -1/10/wcn_bt not found
  btsprdsipc ... failed to create endpoint (-12)

Fix this by:
1. In sipc_sbuf_open(), publishing sbuf->buffers[rx_id].sdev before calling
   rpmsg_register_device(), and rolling back to NULL if registration fails.
2. In __sipc_sbuf_create_ept(), directly using rpdev_to_sbuf_device(rpdev)
   when called for a channel device (rpdev != &sbuf->ctrldev), avoiding the
   redundant search.

Signed-off-by: Seuj09 <jeus110310@gmail.com>
---
 drivers/rpmsg/sprd_sipc_sbuf.c | 35 ++++++++++++++++++++++------------
 1 file changed, 23 insertions(+), 12 deletions(-)

diff --git a/drivers/rpmsg/sprd_sipc_sbuf.c b/drivers/rpmsg/sprd_sipc_sbuf.c
index 47399030b..25022174f 100644
--- a/drivers/rpmsg/sprd_sipc_sbuf.c
+++ b/drivers/rpmsg/sprd_sipc_sbuf.c
@@ -293,25 +293,30 @@ __sipc_sbuf_create_ept(struct sipc_sbuf *sbuf, struct rpmsg_device *rpdev,
 		       rpmsg_rx_cb_t cb, void *priv,
 		       struct rpmsg_channel_info *chinfo)
 {
-	struct rpmsg_driver *rpdrv = to_rpmsg_driver(rpdev->dev.driver);
+	struct rpmsg_driver *rpdrv = rpdev->dev.driver ?
+		to_rpmsg_driver(rpdev->dev.driver) : NULL;
 	struct sipc_sbuf_device *sdev = NULL, *sd;
 	struct rpmsg_endpoint *ept;
 	unsigned long flags;
 	int id;
 
-	rcu_read_lock();
-	for (id = 0; id < sbuf->num_buffers; id++) {
-		sd = rcu_dereference(sbuf->buffers[id].sdev);
-		if (!sd)
-			continue;
-
-		if (chinfo->dst == sd->rpdev.dst || chinfo->src == sd->rpdev.src ||
-		    !strncmp(chinfo->name, sd->rpdev.id.name, RPMSG_NAME_SIZE)) {
-			sdev = sd;
-			break;
+	if (rpdev && rpdev != &sbuf->ctrldev) {
+		sdev = rpdev_to_sbuf_device(rpdev);
+	} else {
+		rcu_read_lock();
+		for (id = 0; id < sbuf->num_buffers; id++) {
+			sd = rcu_dereference(sbuf->buffers[id].sdev);
+			if (!sd)
+				continue;
+
+			if (chinfo->dst == sd->rpdev.dst || chinfo->src == sd->rpdev.src ||
+			    !strncmp(chinfo->name, sd->rpdev.id.name, RPMSG_NAME_SIZE)) {
+				sdev = sd;
+				break;
+			}
 		}
+		rcu_read_unlock();
 	}
-	rcu_read_unlock();
 
 	if (!sdev) {
 		dev_err(&sbuf->dev, "channel %d/%d/%s not found\n",
@@ -354,7 +359,7 @@ __sipc_sbuf_create_ept(struct sipc_sbuf *sbuf, struct rpmsg_device *rpdev,
 	 * driver provides a default callback. If not, receive all buffered
 	 * data on the endpoint as soon as it is created.
 	 */
-	if (rpdev != &sdev->rpdev || !rpdrv->callback) {
+	if (rpdev != &sdev->rpdev || !rpdrv || !rpdrv->callback) {
 		while (sipc_sbuf_try_rx(sdev->sbuf, sdev, chinfo->src))
 			;
 	}
@@ -564,13 +569,6 @@ static int sipc_sbuf_open(struct sipc_channel *channel)
 		rpdev->dev.parent = &sbuf->dev;
 		rpdev->dev.release = sipc_sbuf_rpdev_release;
 
-		ret = rpmsg_register_device(rpdev);
-		if (ret) {
-			dev_err(&sbuf->dev, "failed to register %d/%d\n", rx_id, tx_id);
-			/* rpmsg_register_device calls put_device on error */
-			continue;
-		}
-
 		spin_lock_irqsave(&sbuf->buffer_sdev_lock, flags);
 		if (rcu_access_pointer(sbuf->buffers[rx_id].sdev))
 			ret = -EEXIST;
@@ -579,9 +577,19 @@ static int sipc_sbuf_open(struct sipc_channel *channel)
 		spin_unlock_irqrestore(&sbuf->buffer_sdev_lock, flags);
 
 		if (ret < 0) {
-			device_unregister(&rpdev->dev);
+			kfree(sdev);
 			goto unregister;
 		}
+
+		ret = rpmsg_register_device(rpdev);
+		if (ret) {
+			dev_err(&sbuf->dev, "failed to register %d/%d\n", rx_id, tx_id);
+			spin_lock_irqsave(&sbuf->buffer_sdev_lock, flags);
+			rcu_assign_pointer(sbuf->buffers[rx_id].sdev, NULL);
+			spin_unlock_irqrestore(&sbuf->buffer_sdev_lock, flags);
+			/* rpmsg_register_device calls put_device on error */
+			continue;
 		}
 	}
 
 	ret = sipc_sbuf_create_ctrldev(sbuf);
-- 
2.43.0
