From 57da7c84f6d44c53901f29a00e8d9851b764688a Mon Sep 17 00:00:00 2001
From: Seuj09 <jeus110310@gmail.com>
Date: Sat, 24 Oct 2026 10:42:13 +0000
Subject: [PATCH] arm64: dts: sprd: add the rear camera to the Infinix X6525

The phone's rear camera is an S5K3L6 on i2c0 - the vendor's sensor-main
node, with reset on ap_gpio 45, power-down on ap_gpio 47 and DVDD behind
the load switch on ap_gpio 11 - wired as four MIPI data lanes into the
4-lane CSI port.

The clock is CLK_SENSOR0 at 24 MHz, the rate the vendor HAL runs the part
at; DVDD is modelled as a fixed regulator fed from vddcamd0.

The front OV8856 is not described yet: its bus and address have not been
read off the stock system.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 .../boot/dts/sprd/ums9230-infinix-x6525.dts   | 82 +++++++++++++++++++
 1 file changed, 82 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
index 08f494f0d..e0bcdaa52 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-infinix-x6525.dts
@@ -30,6 +30,7 @@
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/media/sprd-camsys.h>
 #include <dt-bindings/usb/pd.h>
 
 #include "ums9230.dtsi"
@@ -526,6 +527,87 @@ &sc2730_fgu {
 	status = "okay";
 };
 
+/* ---- camera -------------------------------------------------------------
+ * The stock system identifies the rear sensor as an S5K3L6: slot 0 reports
+ * "s5k3l6_1836_13M" in vendor.cam.sensor.slot.info and the stock camera HAL
+ * opens it at 4208x3120 over four MIPI data lanes. The vendor board overlay
+ * puts sensor-main on i2c0 with reset on ap_gpio 45, power-down on ap_gpio 47
+ * and a GPIO-switched DVDD on ap_gpio 11, clocked from CLK_SENSOR0.
+ *
+ * The driver's register tables are extracted from the vendor's own sensor
+ * library (libsensor_s5k3l6.so, "s5k3l6_v1"); it runs the part at a 24 MHz
+ * MCLK with four lanes and the three modes below.
+ *
+ * The front camera is an OV8856, but its bus and address have not been read
+ * off the stock system yet, so it is not described here.
+ */
+/ {
+	vddcamd_main: regulator-vddcamd-main {
+		compatible = "regulator-fixed";
+		regulator-name = "vddcamd-main";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		vin-supply = <&vddcamd0>;
+		gpio = <&ap_gpio 11 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&i2c0 {
+	status = "okay";
+	clock-frequency = <400000>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	camera@20 {
+		compatible = "samsung,s5k3l6";
+		reg = <0x20>;
+		reset-gpios = <&ap_gpio 45 GPIO_ACTIVE_LOW>;
+		power-down-gpios = <&ap_gpio 47 GPIO_ACTIVE_HIGH>;
+
+		clocks = <&mm_gate CLK_MM_SENSOR0_EB>;
+		clock-names = "mclk";
+		assigned-clocks = <&mm_clk CLK_SENSOR0>;
+		assigned-clock-parents = <&pll1 CLK_TWPLL_48M>;
+		assigned-clock-rates = <24000000>;
+
+		vddio-supply = <&vddcamio>;
+		vdda-supply = <&vddcama0>;
+		vddd-supply = <&vddcamd_main>;
+
+		rotation = <90>;
+		orientation = <1>;
+
+		port {
+			s5k3l6_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64
+					<600000000 284000000 153000000>;
+				remote-endpoint = <&csi_4lane_ep>;
+			};
+		};
+	};
+};
+
+&camsys {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 4-lane port: the rear camera */
+		port@CAMSYS_CSI_4LANE {
+			reg = <CAMSYS_CSI_4LANE>;
+
+			csi_4lane_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&s5k3l6_ep>;
+			};
+		};
+	};
+};
+
 /* ---- display ------------------------------------------------------------
  * Confirmed on the device's own cmdline: lcd_name=lcd_td4160_hx_mipi_hdp_x6525,
  * i.e. the TD4160 HX variant at 720x1612. No mainline driver exists for it yet;
