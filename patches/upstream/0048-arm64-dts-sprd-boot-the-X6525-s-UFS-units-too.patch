 	};
 };
 
+/*
+ * UFS - the alternate internal storage. Some X6525 units shipped with a UFS
+ * part instead of the eMMC above; they boot the same image with just this
+ * node (the cmdline names its controller, androidboot.boot_devices=
+ * ...20200000.ufs). vcc is the same core rail the eMMC runs on, and the
+ * kernel already carries CONFIG_SCSI_UFS_SPRD. This mirrors the reeder's
+ * board dts; on an eMMC unit the controller probes, finds nothing and
+ * drops out.
+ */
+&ufs {
+	vcc-supply = <&vddemmccore>;
+	status = "okay";
+};
+
 &modem {
 	status = "okay";
 };
