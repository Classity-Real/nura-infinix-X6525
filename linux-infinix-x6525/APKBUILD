# DRAFT, untested. Packages a kernel built by ../build-kernel.sh (that tree needs its own clang toolchain).
# Put the tarball it produces somewhere pmbootstrap can fetch it (a GitHub release) and set _url/_tarball.
_flavor="infinix-x6525"
pkgname=linux-$_flavor
pkgver=5.4.302
pkgrel=0
pkgdesc="Infinix X6525 (Unisoc UMS9230 / T606) kernel (prebuilt Helix Image)"
arch="aarch64"
url="https://github.com/Seuj09/android_kernel_ums9230"
license="GPL-2.0-only"
options="!strip !check !tracedeps"
_tarball="linux-infinix-x6525-$pkgver-Helix+.tar.gz"
source="$_tarball::https://github.com/Seuj09/pmos-infinix-x6525/releases/download/v$pkgver/$_tarball"
builddir="$srcdir"

package() {
	install -Dm644 arch/arm64/boot/Image "$pkgdir/boot/vmlinuz"
	install -Dm644 .config "$pkgdir/usr/share/kernel/$_flavor/config"
	mkdir -p "$pkgdir/lib"
	cp -a lib/modules "$pkgdir/lib/"
}
sha512sums="
CHANGEME  linux-infinix-x6525-5.4.302-Helix+.tar.gz
"
