# Config fragment merged onto config-helix-stock.aarch64 (the config embedded in your boot.img).
# Every symbol below was checked against that config.

# --- missing for postmarketOS ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SQUASHFS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
# CONFIG_MODULE_SIG_FORCE is not set

# --- USB networking: Unisoc vendor RNDIS gadget (registers function "rndis", interface usb0) ---
# Leave mainline USB_CONFIGFS_RNDIS/NCM/ECM OFF: they register rndis again / pull in a second u_ether.
CONFIG_SPRD_USB_U_ETHER=y
CONFIG_SPRD_USB_F_RNDIS=y
CONFIG_SPRD_USB_CONFIGFS_RNDIS=y
CONFIG_SPRD_USBPINMUX=y            # without this the gadget never connects
CONFIG_SPRD_USBPINMUX_QOGIRL6=y
CONFIG_SPRD_QOGIRL6_USB2_PHY=y

# --- stock =m, but needed before the rootfs can be found ---
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS9230_CLK=y
CONFIG_PINCTRL_SPRD=y
CONFIG_PINCTRL_SPRD_QOGIRL6=y
CONFIG_GPIO_SPRD=y
CONFIG_GPIO_EIC_SPRD=y
CONFIG_SPRD_DMA=y
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_I2C_SPRD=y
CONFIG_I2C_SPRD_HW_V2=y
CONFIG_SPI_SPRD=y
CONFIG_SPI_SPRD_ADI=y
CONFIG_MFD_SC27XX_PMIC=y
CONFIG_REGULATOR_SC2730=y
CONFIG_SPRD_PMIC_SYSCON=y
CONFIG_MMC_SDHCI_SPRD=y            # eMMC controller

# --- display (not needed for SSH; add FBDEV when you want logs on the panel) ---
CONFIG_DRM_SPRD=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_TOUCHSCREEN_OMNIVISION_TCM=y   # panel/touch variants differ per unit; see NOTES.md
CONFIG_TOUCHSCREEN_FOCALTECH_SPI=y
