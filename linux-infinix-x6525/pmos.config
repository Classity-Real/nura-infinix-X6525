# Config fragment for a `pmos` branch of android_kernel_ums9230.
# Everything below was checked against the config embedded in your boot.img.

# --- missing for postmarketOS ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SQUASHFS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
# Currently on and blocks unsigned modules:
# CONFIG_MODULE_SIG_FORCE is not set
# USB networking. Try NCM first. The vendor SPRD_USB_CONFIGFS_RNDIS may collide with the mainline RNDIS symbol.
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y

# --- currently =m, but needed before the rootfs can be found; make built-in ---
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS9230_CLK=y
CONFIG_PINCTRL_SPRD=y
CONFIG_PINCTRL_SPRD_QOGIRL6=y
CONFIG_GPIO_SPRD=y
CONFIG_GPIO_EIC_SPRD=y
CONFIG_SPRD_DMA=y
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_I2C_SPRD=y
CONFIG_I2C_SPRD_HW_V2=y
CONFIG_SPI_SPRD=y
CONFIG_SPI_SPRD_ADI=y
CONFIG_MFD_SC27XX_PMIC=y
CONFIG_REGULATOR_SC2730=y
CONFIG_SPRD_PMIC_SYSCON=y
CONFIG_MMC_SDHCI_SPRD=y        # eMMC controller
CONFIG_SPRD_QOGIRL6_USB2_PHY=y # USB
CONFIG_DRM_SPRD=y              # display
CONFIG_BACKLIGHT_PWM=y
CONFIG_TOUCHSCREEN_OMNIVISION_TCM=y   # panel/touch variants differ per unit; see NOTES
CONFIG_TOUCHSCREEN_FOCALTECH_SPI=y
